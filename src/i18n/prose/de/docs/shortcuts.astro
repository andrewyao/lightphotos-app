---
// Every row here is a string the app's own help dialog (?) shows, so this
// page can be checked against the build rather than against memory. Rows are
// grouped by what you are doing, not by which panel owns the key.
const groups = [
  {
    title: "Navigation",
    rows: [
      { key: "Cmd+O", does: "Einen Ordner hinzufügen und öffnen" },
      { key: "Enter / Space / E", does: "Das ausgewählte Foto öffnen (im Raster)" },
      { key: "Esc / G", does: "Zurück zum Raster (im Editor)" },
      { key: "← / →", does: "Vorheriges / nächstes Foto im Editor; im Raster die Hervorhebung bewegen" },
      { key: "Page Up / Page Down", does: "Vorheriges / nächstes Foto (im Editor)" },
      { key: "D", does: "Das ausgewählte Foto anpassen" },
      { key: "C", does: "2 bis 6 ausgewählte Fotos oder den ausgewählten Stapel vergleichen" },
      { key: "I", does: "Fotoinfo im rechten Bereich zeigen oder ausblenden" },
