      { key: "O / Shift+O", does: "Die Flecken zeigen oder ausblenden / den nächsten Fleck auswählen" },
      { key: "Delete", does: "Den ausgewählten Fleck löschen" },
      { key: "Cmd+Z", does: "Den letzten Fleck widerrufen" },
      { key: "Esc", does: "Retusche verlassen" },
