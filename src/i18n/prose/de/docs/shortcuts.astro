      { key: "Cmd+Shift+G", does: "Die ausgewählten Stapel auflösen" },
      { key: "Shift+Delete", does: "Die ausgewählten Stapel löschen oder auflösen und die Fotos behalten" },
    ],
  },
  {
    title: "Zoomen und Verschieben",
    rows: [
      { key: "Space / Z", does: "Zoom wechseln: einpassen, 2x eingepasst, 100%" },
