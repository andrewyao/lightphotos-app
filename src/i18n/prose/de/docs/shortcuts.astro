      { key: "Alt+= / Alt+-", does: "Größerer / kleinerer Text" },
      { key: "?", does: "Die Liste der Tastaturkurzbefehle in der App zeigen oder ausblenden" },
    ],
  },
  {
    title: "Bewerten, markieren und Farbmarkierung",
