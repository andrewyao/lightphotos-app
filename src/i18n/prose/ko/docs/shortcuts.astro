---
// Every row here is a string the app's own help dialog (?) shows, so this
// page can be checked against the build rather than against memory. Rows are
// grouped by what you are doing, not by which panel owns the key.
const groups = [
  {
    title: "탐색",
    rows: [
      { key: "Cmd+O", does: "폴더를 추가하고 열기" },
      { key: "Enter / Space / E", does: "선택한 사진 열기 (그리드에서)" },
      { key: "Esc / G", does: "편집 화면에서 그리드로 돌아가기" },
      { key: "← / →", does: "이전 / 다음 사진 (편집 화면에서). 그리드에서는 선택 이동" },
      { key: "Page Up / Page Down", does: "이전 / 다음 사진 (편집 화면에서)" },
      { key: "D", does: "선택한 사진 조정" },
      { key: "C", does: "선택한 사진 2~6장 또는 선택한 스택 비교" },
      { key: "I", does: "오른쪽 패널에서 사진 정보 표시 또는 숨기기" },
      { key: "F6 / Shift+F6", does: "다음 영역으로 이동하거나, 들어간 영역 안에서 다음 컨트롤로 이동" },
      { key: "Tab / Shift+Tab", does: "포커스된 영역 안에서 항목 간 이동" },
      { key: "Cmd+,", does: "설정: 테마, 언어" },
      { key: "Alt+= / Alt+-", does: "글자 크게 / 작게" },
