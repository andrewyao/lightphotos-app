      { key: "Drag", does: "칠하기. 획마다 실행 취소 한 단계" },
      { key: "Alt+Drag", does: "지우기" },
      { key: "[ / ]", does: "브러시 크기 (스크롤도 가능)" },
      { key: "Shift+[ / ]", does: "브러시 페더 (Shift+스크롤도 가능)" },
      { key: "Esc", does: "브러시 내려놓기" },
    ],
  },
  {
    title: "잡티 제거",
    rows: [
      { key: "Q", does: "잡티 제거 켜기 / 끄기" },
      { key: "[ / ]", does: "브러시 크기 (스크롤도 가능)" },
      { key: "Shift+[ / ]", does: "브러시 페더 (Shift+스크롤도 가능)" },
      { key: "O / Shift+O", does: "잡티 표시 또는 숨기기 / 다음 잡티 선택" },
      { key: "Delete", does: "선택한 잡티 삭제" },
      { key: "Cmd+Z", does: "마지막 잡티 실행 취소" },
      { key: "Esc", does: "잡티 제거 종료" },
    ],
  },
  {
    title: "대표 사진 선택",
    rows: [
      { key: "Click or drag the photo", does: "초점 영역 이동" },
      { key: "Shift+Scroll on the area", does: "초점 영역 크기 조절" },
      { key: "Drag a tile", does: "초점 영역 이동" },
      { key: "Cmd+Click / Shift+Click a tile", does: "타일 더 선택" },
    ],
  },
];
---
<p>
  LightPhotos는 키보드로 조작하도록 만들었어요. 마우스를 건드리지 않고
  폴더 전체에 별점을 매기고, 촬영분을 원래 크기로 넘겨 보고, 한 사진의 룩을
  나머지에 적용할 수 있어요. 아래 목록은 앱이 인식하는 모든 키이고,
  <kbd>?</kbd>를 누르면 내 컴퓨터에 맞는 같은 목록을 앱 안에서 볼 수 있어요.
</p>

{groups.map((g) => (
  <section>
    <h2>{g.title}</h2>
    <div class="lp-compare-wrap">
      <table class="lp-compare">
        <thead>
          <tr>
            <th scope="col">키</th>
            <th scope="col">동작</th>
          </tr>
        </thead>
        <tbody>
          {g.rows.map((r) => (
            <tr>
              <td><kbd>{r.key}</kbd></td>
              <td>{r.does}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
))}
