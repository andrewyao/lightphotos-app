---
import { execSync } from "node:child_process";
import {
  canonicalUrl,
  defaultLocale,
  localeInfo,
  localePath,
  localizeLinks,
  locales,
  webAppHref,
  type Locale,
} from "../i18n/locales";
import { fill, ui } from "../i18n/ui";

// Shared <head> boilerplate, site nav and footer. `active` picks which nav link
// (if any) gets lp-active; app.html has no nav of its own to link back from, so
// "app" is never a valid value here.
//
// `lang` is the page's language. `path` is the page's English path ("/",
// "/downloads.html") and is passed only by pages that exist in every language:
// it turns on the language switcher and the canonical/hreflang links. Pages that
// omit it stay English-only. `translated={false}` is for pages whose body is
// English in every language (the blog posts): they get the localized header and
// switcher, but every language's URL canonicalises to the English one and no
// hreflang alternates are emitted.
//
// Icons are Phosphor, self-hosted from public/phosphor/ — no external requests.
// Body/display/mono text uses the platform's own font stacks (see lp.css).
interface Props {
  title: string;
  desc: string;
  active?: "downloads" | "blogs" | "docs";
  lang?: Locale;
  path?: string;
  translated?: boolean;
}
const { title, desc, active, lang = defaultLocale, path, translated = true } = Astro.props;
const t = ui(lang);
const href = (p: string) => localePath(lang, p);

// Prose in other languages is written with the English site's internal hrefs;
// point them at the page's own language here. English pages render as before.
const body = lang === defaultLocale ? undefined : localizeLinks(await Astro.slots.render("default"), lang);

// Build-time git short hash, shown bottom-right so deployed pages can be traced
// back to a commit. Falls back to "dev" outside a git checkout.
let buildVersion = "dev";
try {
  buildVersion = execSync("git rev-parse --short HEAD", { cwd: import.meta.dirname }).toString().trim();
} catch (e) {}

// Server invite, not a channel link: channel URLs only open for existing members.
const DISCORD_INVITE = "https://discord.gg/H4zCSVRqDn";
const SHOW_DISCORD = false;
---
<!doctype html>
<html lang={localeInfo[lang].htmlLang}>
<head>
<meta charset="utf-8" />
<script is:inline>
(function () {
  try {
    var t = localStorage.getItem('lp-theme');
    if (t === 'light' || t === 'neutral' || t === 'dark') {
      document.documentElement.setAttribute('data-theme', t);
    }
  } catch (e) {}
})();
// The web app is WebAssembly, renders with WebGPU and opens folders through
// the File System Access API, so links to it (the nav's "Open in browser" tab,
// WebAppLink) give way where any is missing. Set before the nav is parsed so
// nothing flashes in and out.
if (typeof WebAssembly !== 'object' || !navigator.gpu || typeof window.showDirectoryPicker !== 'function') {
  document.documentElement.setAttribute('data-lp-webapp', '0');
}
</script>
<style is:inline>
  :root[data-lp-webapp="0"] [data-needs-webapp],
  :root:not([data-lp-webapp="0"]) [data-lacks-webapp] {
    display: none;
  }
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={desc} />
<title>{title}</title>
<link rel="stylesheet" href={`/lp.css?v=${buildVersion}`}>
<!-- Copied into public/ by the lightphotos repo's scripts/deploy-web.sh. -->
{path && <link rel="canonical" href={canonicalUrl(translated ? lang : defaultLocale, path)} />}
{path && translated && locales.map((l) => <link rel="alternate" hreflang={localeInfo[l].htmlLang} href={canonicalUrl(l, path)} />)}
{path && translated && <link rel="alternate" hreflang="x-default" href={canonicalUrl(defaultLocale, path)} />}
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
  <header class="lp-site-header">
    <a class="lp-brand" href={href("/")}>Light<span class="lp-light">Photos</span></a>
    <div class="lp-header-right">
    <nav aria-label={t.nav.main}>
      <a href={href("/downloads.html")} class={active === "downloads" ? "lp-active" : undefined}><i class="ph ph-download-simple lp-nav-icon" aria-hidden="true"></i><span class="lp-nav-label">{t.nav.downloads}</span></a>
      <a href={webAppHref(lang)} target="_blank" rel="noopener" data-needs-webapp><i class="ph ph-app-window lp-nav-icon" aria-hidden="true"></i><span class="lp-nav-label">{t.nav.openInBrowser}<i class="ph ph-arrow-square-out lp-ext-icon" aria-hidden="true"></i></span></a>
      <a href={href("/blogs.html")} class={active === "blogs" ? "lp-active" : undefined}><i class="ph ph-article lp-nav-icon" aria-hidden="true"></i><span class="lp-nav-label">{t.nav.blogs}</span></a>
      <a href={href("/docs.html")} class={active === "docs" ? "lp-active" : undefined}><i class="ph ph-question lp-nav-icon" aria-hidden="true"></i><span class="lp-nav-label">{t.nav.help}</span></a>
      {SHOW_DISCORD && <a class="lp-nav-glyph" href={DISCORD_INVITE} target="_blank" rel="noopener" aria-label="Join the LightPhotos Discord" title="Discord"><i class="ph ph-discord-logo" aria-hidden="true"></i></a>}
      <a class="lp-nav-glyph" href="https://github.com/andrewyao/lightphotos" target="_blank" rel="noopener" aria-label={t.nav.github} title="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg></a>
    </nav>
    {path && (
      <details class="lp-lang">
        <summary class="lp-lang-btn" aria-label={t.nav.language} title={t.nav.language}><i class="ph ph-translate" aria-hidden="true"></i></summary>
        <ul class="lp-lang-menu">
          {locales.map((l) => (
            <li>
              <a href={localePath(l, path)} lang={localeInfo[l].htmlLang} hreflang={localeInfo[l].htmlLang} aria-current={l === lang ? "true" : undefined}>{localeInfo[l].name}</a>
            </li>
          ))}
        </ul>
      </details>
    )}
    <div class="lp-theme-toggle">
      <button type="button" class="lp-theme-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="lp-theme-menu" aria-label={t.nav.theme} title={t.nav.theme}>
        <i class="ph ph-sun" data-theme-icon="light" aria-hidden="true"></i>
        <i class="ph ph-circle-half" data-theme-icon="neutral" aria-hidden="true"></i>
        <i class="ph ph-moon" data-theme-icon="dark" aria-hidden="true"></i>
      </button>
      <div class="lp-theme-menu" id="lp-theme-menu" role="menu" aria-label={t.nav.theme} hidden>
        <button type="button" role="menuitemradio" data-theme-choice="light" aria-checked="false"><i class="ph ph-sun" aria-hidden="true"></i>{t.nav.themeLight}</button>
        <button type="button" role="menuitemradio" data-theme-choice="neutral" aria-checked="false"><i class="ph ph-circle-half" aria-hidden="true"></i>{t.nav.themeNeutral}</button>
        <button type="button" role="menuitemradio" data-theme-choice="dark" aria-checked="true"><i class="ph ph-moon" aria-hidden="true"></i>{t.nav.themeDark}</button>
      </div>
    </div>
    </div>
  </header>

  {body === undefined ? <slot /> : <Fragment set:html={body} />}

  <footer class="lp-site-footer">
    <span class="lp-version">{t.footer.author}</span>
    <a class="lp-version" href="https://github.com/andrewyao/lightphotos/issues">{t.footer.feedback}</a>
    <a class="lp-version" href={href("/privacy.html")}>{t.footer.privacy}</a>
    <a class="lp-version" href={href("/terms.html")}>{t.footer.terms}</a>
    <a class="lp-version" href="/app/THIRD-PARTY-LICENSES.txt">{t.footer.licenses}</a>
    <span class="lp-version" title={fill(t.footer.build, { v: buildVersion })}>{fill(t.footer.version, { v: buildVersion })}</span>
  </footer>

<script src={`/lp-theme.js?v=${buildVersion}`} is:inline></script>
<script src={`/lp-analytics.js?v=${buildVersion}`} is:inline></script>
</body>
</html>
