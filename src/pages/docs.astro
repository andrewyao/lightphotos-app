---
// /docs.html is the entry point every nav link, landing card and breadcrumb
// points at, so it forwards straight to the first topic rather than sitting
// as an index nobody asked for — the sidebar on each topic is the index.
// Astro has no built-in redirect for static output, so this is a meta refresh
// with a real link underneath for anything that ignores it.
const target = "/docs/open-the-app.html";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>LightPhotos Help</title>
    <style>
      html { color-scheme: dark light; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-content: center;
        gap: 0.75rem;
        padding: 2rem;
        text-align: center;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: #14110c;
        color: #f3eee3;
      }
      a { color: #4f8cff; }
    </style>
  </head>
  <body>
    <p>Opening the LightPhotos documentation&hellip;</p>
    <p><a href={target}>Getting started: Open the app</a></p>
  </body>
</html>
