---
import Base from "../layouts/Base.astro";
---
<Base
  title="LightPhotos — Every photo, seen in its best light"
  desc="LightPhotos — a fast, private photo editor that runs in your browser or as a desktop app."
>
  <main class="lp-page">
    <section class="lp-hero">
      <div class="lp-glow"></div>
      <h1 class="lp-wordmark">Light<span class="lp-light">Photos</span></h1>
      <p class="lp-lede">
        A fast, private photo editor. It runs entirely in your browser &mdash;
        or install the desktop app &mdash; and every edit happens locally,
        right on your own machine.
      </p>
    </section>

    <section class="lp-actions" aria-label="Explore LightPhotos">
      <a class="lp-card" href="/app.html">
        <svg class="lp-shot" viewBox="0 0 320 200" role="img" aria-label="LightPhotos running in a browser">
          <rect x="1" y="1" width="318" height="198" rx="14" fill="#fffdfa" stroke="#eadfcb"/>
          <circle cx="22" cy="16" r="4.5" fill="#e8927c"/>
          <circle cx="37" cy="16" r="4.5" fill="#ecc94b"/>
          <circle cx="52" cy="16" r="4.5" fill="#9ac586"/>
          <defs>
            <linearGradient id="lp-sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffe9c7"/>
              <stop offset="1" stop-color="#ffb454"/>
            </linearGradient>
          </defs>
          <rect x="14" y="34" width="292" height="112" rx="8" fill="url(#lp-sky)"/>
          <circle cx="252" cy="68" r="16" fill="#fff3dd" opacity="0.9"/>
          <polygon points="14,146 108,78 196,146" fill="#c98a45"/>
          <polygon points="118,146 214,88 306,146" fill="#a06a30"/>
          <rect x="14" y="158" width="292" height="5" rx="2.5" fill="#efe7d8"/>
          <circle cx="96" cy="160.5" r="6" fill="#ffb454" stroke="#fffdfa" stroke-width="2"/>
          <rect x="14" y="176" width="292" height="5" rx="2.5" fill="#efe7d8"/>
          <circle cx="204" cy="178.5" r="6" fill="#b8722a" stroke="#fffdfa" stroke-width="2"/>
        </svg>
        <h2>Web <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>The app running live in your browser. Nothing to install &mdash; jump straight in and try it on your own photos.</p>
      </a>

      <a class="lp-card" href="/downloads.html">
        <svg class="lp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="">
          <path d="M12 3v11"/>
          <path d="m8 10 4 4 4-4"/>
          <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
        </svg>
        <h2>Downloads <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>Native desktop builds for macOS, Windows and Linux. Same editor, faster startup.</p>
      </a>

      <a class="lp-card" href="/blogs.html">
        <svg class="lp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="">
          <path d="M4 20l4.5-1L20 7.5a2.12 2.12 0 0 0-3-3L5.5 16 4 20z"/>
          <path d="M14 6l3 3"/>
        </svg>
        <h2>Blogs <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>Write-ups on the architectural challenges: WebAssembly, threading, color pipelines and more.</p>
      </a>

      <a class="lp-card" href="/docs.html">
        <svg class="lp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        <h2>Help <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>Documentation: user guides, supported formats, keyboard shortcuts and common questions.</p>
      </a>
    </section>
  </main>
</Base>
