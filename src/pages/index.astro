---
import Base from "../layouts/Base.astro";
---
<Base
  title="LightPhotos — a free, open-source Lightroom alternative for RAW photos"
  desc="Cull, rate, edit and export RAW photos fast. A free, open-source alternative to Lightroom for macOS, Windows, Linux and the browser. No subscription, no account, and your photos never leave your computer."
>
  <style is:inline>
    /* No WebGPU means the web build cannot run, so the browser button goes and
       only Download is left. Decided by the script below, never by default, so
       a visitor with JS off still sees both. */
    :root[data-lp-webgpu="0"] [data-needs-webgpu] {
      display: none;
    }
  </style>
  <script is:inline>
  // Runs before the hero is parsed, so the Download button never paints the generic
  // wording and then blinks over to the visitor's own platform.
  (function () {
    var ua = navigator.userAgent || "";

    // First match wins: the mobile bail-out has to come before its broader
    // neighbours, because Android's user agent string also says "Linux".
    var RULES = [
      { id: null, test: /Android|iPhone|iPad|iPod|CrOS/ },
      { id: "windows", test: /Windows NT/ },
      { id: "macos", test: /Mac OS X|Macintosh/ },
      { id: "linux", test: /Linux|X11/ },
    ];

    var id = null;
    for (var i = 0; i < RULES.length; i++) {
      if (RULES[i].test.test(ua)) { id = RULES[i].id; break; }
    }

    if (id) document.documentElement.setAttribute("data-lp-os", id);
    else document.documentElement.removeAttribute("data-lp-os");

    // The web build needs WebGPU, so the Web card only stays when the browser
    // can actually run it. navigator.gpu is the API test; Firefox, Safari and
    // phones/tablets are also excluded by name, because the web app is only
    // offered on desktop Chromium browsers today -- see the copy on the Web
    // card itself. Written before the card is parsed, so nothing flashes first.
    var isSafari = /Safari/.test(ua) && !/Chrome|Chromium|Edg|OPR/.test(ua);
    var noWebgpu = !navigator.gpu ||
                   /Firefox|FxiOS|Android|iPhone|iPad|iPod/.test(ua) ||
                   isSafari;
    document.documentElement.setAttribute("data-lp-webgpu", noWebgpu ? "0" : "1");
  })();
  </script>

  <main class="lp-page">
    <section class="lp-hero">
      <div class="lp-glow"></div>
      <div class="lp-hero-intro">
        <div class="lp-hero-copy">
          <h1 class="lp-tagline">Cull and edit RAW photos fast.</h1>
          <p class="lp-lede">
            A free, open-source Lightroom alternative for macOS, Windows, Linux and
            the browser. Nothing leaves your computer.
          </p>
          <div class="lp-hero-cta">
            <a class="lp-btn lp-hero-dl" href="/downloads.html">Download</a>
            <a class="lp-btn lp-btn--ghost" href="/app.html" data-needs-webgpu>Open in browser</a>
          </div>
          <script is:inline>
          // Names the visitor's platform on the Download button, before first
          // paint. Crawlers, phones and no-JS visitors keep the generic label.
          (function () {
            var OS = { macos: "macOS", windows: "Windows", linux: "Linux" };
            var os = OS[document.documentElement.getAttribute("data-lp-os")];
            if (os) document.querySelector(".lp-hero-dl").textContent = "Download for " + os;
          })();
          </script>
        </div>

        <figure class="lp-demo">
          <button class="lp-demo-open" type="button" aria-haspopup="dialog" aria-label="Play the demo larger">
            <video
              class="lp-demo-video"
              src="/demo.mp4"
              poster="/demo-poster.jpg"
              width="1600"
              height="1000"
              muted
              loop
              playsinline
              aria-hidden="true"
            ></video>
            <span class="lp-demo-expand" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/></svg>
            </span>
          </button>
          <figcaption class="lp-demo-caption">Number keys rate, arrows move, Enter opens, Space zooms to 100%.</figcaption>
        </figure>
      </div>
    </section>

    <section aria-labelledby="flow-head">
      <div class="lp-section-head">
        <h2 id="flow-head">What you can do today</h2>
      </div>
      <ol class="lp-flow">
        <li><strong>Open a folder</strong><span>Any folder on your disk. No import, no catalog.</span></li>
        <li><strong>Cull</strong><span>Rate with 0&ndash;5, filter by stars, check focus at 100%.</span></li>
        <li><strong>Edit</strong><span>Tone, white balance, color, denoise, spot removal, Auto Tone.</span></li>
        <li><strong>Export</strong><span>Full-quality JPEGs at the size you choose. Originals untouched.</span></li>
        <li><strong>Share</strong><span>Send exports to your own <a href="/blogs/exporting-to-your-own-immich-server.html">Immich server</a>.</span></li>
      </ol>
    </section>

    <dialog class="lp-demo-modal" aria-label="LightPhotos demo">
      <button class="lp-demo-close" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <video
        class="lp-demo-modal-video"
        src="/demo.mp4"
        poster="/demo-poster.jpg"
        width="1600"
        height="1000"
        muted
        loop
        playsinline
        controls
        preload="none"
        aria-label="Rating twelve RAW photos with the number keys, opening a flower in the editor, zooming to 100 percent, and returning to the rated grid"
      ></video>
    </dialog>
    <script is:inline>
    // The inline preview autoplays only for visitors who haven't asked for
    // less motion; everyone else sees the poster until they open the modal.
    // The modal copy has controls and plays from the start each time it opens.
    (function () {
      var inline = document.querySelector(".lp-demo-video");
      var open = document.querySelector(".lp-demo-open");
      var modal = document.querySelector(".lp-demo-modal");
      if (!inline || !open || !modal) return;
      var big = modal.querySelector("video");
      var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduce) inline.play().catch(function () {});

      open.addEventListener("click", function () {
        inline.pause();
        modal.showModal();
        big.currentTime = 0;
        big.play().catch(function () {});
      });
      modal.querySelector(".lp-demo-close").addEventListener("click", function () {
        modal.close();
      });
      // A click that lands on the dialog itself, not its contents, is the backdrop.
      modal.addEventListener("click", function (e) {
        if (e.target === modal) modal.close();
      });
      modal.addEventListener("close", function () {
        big.pause();
        if (!reduce) inline.play().catch(function () {});
      });
    })();
    </script>

    <section class="lp-features" aria-label="What LightPhotos does">
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="6" y="6" width="12" height="12" rx="2"/>
          <path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"/>
        </svg>
        <h3>Fast on big files</h3>
        <p>Previews and sliders render on the GPU. macOS also uses the system&rsquo;s native RAW decoder.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4.5" width="18" height="15" rx="2"/>
          <circle cx="8.5" cy="10" r="1.8"/>
          <path d="M4 17l4.5-4.5 3.5 3.5 3-3 5 5"/>
        </svg>
        <h3>Opens your RAW files</h3>
        <p>Sony, Canon, Nikon, Fujifilm, Panasonic, Olympus, Pentax, Leica, phone DNGs, JPEG and TIFF. <a href="/docs/formats.html">Tested cameras</a>.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3-6.7"/>
          <path d="M3 4v4h4"/>
        </svg>
        <h3>Non-destructive</h3>
        <p>Edits are saved as small sidecar files next to your photos. Originals never change.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3.5l8.5 4.7-8.5 4.7L3.5 8.2z"/>
          <path d="M3.5 12.6l8.5 4.7 8.5-4.7"/>
        </svg>
        <h3>Batch edits</h3>
        <p>Copy adjustments to many photos at once.</p>
      </div>
    </section>

    <section class="lp-actions" aria-label="Keep exploring">
      <a class="lp-card" href="/lightroom-alternative.html">
        <i class="ph-bold ph-scales" aria-hidden="true"></i>
        <h2>Lightroom <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>What you gain by switching, and what LightPhotos does not do yet.</p>
      </a>

      <a class="lp-card" href="/linux-raw-photo-editor.html">
        <i class="ph-bold ph-terminal-window" aria-hidden="true"></i>
        <h2>Linux <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>Lightroom has never run on Linux. Native ARM and x86 builds of LightPhotos do.</p>
      </a>

      <a class="lp-card" href="/blogs.html">
        <i class="ph-bold ph-pencil-simple" aria-hidden="true"></i>
        <h2>Blogs <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>Write-ups on the hard parts: WebAssembly, threading, RAW decoding and color pipelines.</p>
      </a>

      <a class="lp-card" href="/docs.html">
        <i class="ph-bold ph-book-open" aria-hidden="true"></i>
        <h2>Help <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>User guides, supported formats, keyboard shortcuts and common questions.</p>
      </a>

    </section>
  </main>
</Base>
