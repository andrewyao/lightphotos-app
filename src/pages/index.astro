---
import Base from "../layouts/Base.astro";
---
<Base
  title="LightPhotos — a local-first, Lightroom-style photo manager"
  desc="LightPhotos is a fast, private photo manager for large libraries. Cull, rate, organize and develop your RAW files — in your browser or as a native desktop app. Nothing leaves your machine."
>
  <style is:inline>
    /* One message per platform, all hidden until the sniffer below picks one.
       Without JS the visitor keeps the line that names every size. */
    .lp-os-size-item { display: none; }
    :root[data-lp-os="macos"] .lp-os-size-item[data-os="macos"],
    :root[data-lp-os="windows"] .lp-os-size-item[data-os="windows"],
    :root[data-lp-os="linux"] .lp-os-size-item[data-os="linux"] { display: inline; }
    :root[data-lp-os] .lp-os-size-all { display: none; }

    /* No WebGPU means the web build cannot run: the heading promises two
       ways, so it goes with the Web card and only the native one is left, and
       the native card drops the sentence that compares it to a web version the
       visitor has just stopped being shown. Decided by the script below, never
       by default, so a visitor with JS off still sees both. Held to one card's
       width rather than stretching across the hero on its own. */
    :root[data-lp-webgpu="0"] .lp-hero-split .lp-section-head,
    :root[data-lp-webgpu="0"] [data-needs-webgpu] {
      display: none;
    }
    :root[data-lp-webgpu="0"] .lp-hero-split .lp-split {
      max-width: 34rem;
      margin-inline: auto;
    }
  </style>
  <script is:inline>
  // Runs before the hero is parsed, so the size line never paints the generic
  // wording and then blinks over to the visitor's own platform.
  (function () {
    var ua = navigator.userAgent || "";

    // First match wins: the mobile bail-out has to come before its broader
    // neighbours, because Android's user agent string also says "Linux".
    var RULES = [
      { id: null, test: /Android|iPhone|iPad|iPod|CrOS/ },
      { id: "windows", test: /Windows NT/ },
      { id: "macos", test: /Mac OS X|Macintosh/ },
      { id: "linux", test: /Linux|X11/ },
    ];

    var id = null;
    for (var i = 0; i < RULES.length; i++) {
      if (RULES[i].test.test(ua)) { id = RULES[i].id; break; }
    }

    if (id) document.documentElement.setAttribute("data-lp-os", id);
    else document.documentElement.removeAttribute("data-lp-os");

    // The web build needs WebGPU, so the Web card only stays when the browser
    // can actually run it. navigator.gpu is the API test; Firefox, Safari and
    // phones/tablets are also excluded by name, because the web app is only
    // offered on desktop Chromium browsers today -- see the copy on the Web
    // card itself. Written before the card is parsed, so nothing flashes first.
    var isSafari = /Safari/.test(ua) && !/Chrome|Chromium|Edg|OPR/.test(ua);
    var noWebgpu = !navigator.gpu ||
                   /Firefox|FxiOS|Android|iPhone|iPad|iPod/.test(ua) ||
                   isSafari;
    document.documentElement.setAttribute("data-lp-webgpu", noWebgpu ? "0" : "1");
  })();
  </script>

  <main class="lp-page">
    <section class="lp-hero">
      <div class="lp-glow"></div>
      <h1 class="lp-wordmark">Light<span class="lp-light">Photos</span></h1>
      <p class="lp-lede">
        A Lightroom-style photo manager that keeps everything on your own
        computer. Cull a shoot, rate and organize a big library, and develop
        your RAW files non-destructively &mdash; No account, no cost, and <a href="https://github.com/andrewyao/lightphotos" target="_blank">open source</a>.
      </p>

      <section class="lp-hero-split" aria-labelledby="run-modes">
        <div class="lp-section-head">
          <h2 id="run-modes">Two ways to run it</h2>
        </div>

        <div class="lp-split">
          <a class="lp-split-card" href="/app.html" data-needs-webgpu>
            <div class="lp-split-head">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M3 12h18M12 3c3 3.6 3 14.4 0 18M12 3c-3 3.6-3 14.4 0 18"/>
              </svg>
              <h3>Web</h3>
              <span class="lp-split-tag">No install</span>
            </div>
            <p class="lp-split-lede">
              Runs the latest version entirely in your browser through WebAssembly
              and Rust. Point it at a folder and start working.
            </p>
            <ul class="lp-check">
              <li>The entire application is under <strong>9MB (WebAssembly)</strong>.</li>
              <li>Works in Chrome or any WebGPU enabled browser.</li>
            </ul>
            <span class="lp-split-cta">Open the web app <span aria-hidden="true">&rarr;</span></span>
          </a>

          <a class="lp-split-card lp-split-card--accent" href="/downloads.html">
            <div class="lp-split-head">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4.5" width="18" height="12" rx="2"/>
                <path d="M8.5 20h7M12 16.5v3.5"/>
              </svg>
              <h3>Native</h3>
              <span class="lp-split-tag">Fastest</span>
            </div>
            <p class="lp-split-lede" data-needs-webgpu>
              Same interface as the Web Assembly version &mdash; with a faster
              decode pipeline tuned to each platform.
            </p>
            <ul class="lp-check">
              <li class="lp-os-size">
                <span class="lp-os-size-item" data-os="macos">The entire application is under <strong>12MB (macOS)</strong>.</span>
                <span class="lp-os-size-item" data-os="windows">The entire application is under <strong>20MB (Windows)</strong>.</span>
                <span class="lp-os-size-item" data-os="linux">The entire application is under <strong>28MB (Linux)</strong>.</span>
                <span class="lp-os-size-all">Extremely small &mdash; the entire application is under <strong>12MB on macOS, 20MB on Windows and 28MB on Linux</strong>.</span>
              </li>
              <li>Supports macOS, Windows, Linux on ARM and x86 &mdash; Ubuntu 24.04+, Debian 13+, Fedora 40+.</li>
            </ul>
            <span class="lp-split-cta">See downloads <span aria-hidden="true">&rarr;</span></span>
          </a>
        </div>
      </section>

    </section>

    <section class="lp-features" aria-label="What LightPhotos does">
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="6" y="6" width="12" height="12" rx="2"/>
          <path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"/>
        </svg>
        <h3>GPU-accelerated engine</h3>
        <p>Previews and adjustments render on the GPU, so panning, zooming and slider changes stay smooth even on large files.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="8" x2="20" y2="8"/>
          <line x1="4" y1="16" x2="20" y2="16"/>
          <circle cx="9" cy="8" r="2.6" fill="currentColor" stroke="none"/>
          <circle cx="15" cy="16" r="2.6" fill="currentColor" stroke="none"/>
        </svg>
        <h3>Professional adjustments</h3>
        <p>Exposure, contrast, white balance, HSL, tone curves, sharpening and crop &mdash; the controls you expect from a serious editor.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3-6.7"/>
          <path d="M3 4v4h4"/>
        </svg>
        <h3>Non-destructive workflow</h3>
        <p>Every edit is an instruction and resets cleanly. Your originals are never modified. All edits are written to sidecar files under .lightphotos in each folder.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="7" width="14" height="13" rx="2"/>
          <path d="M8 7V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/>
        </svg>
        <h3>Complete image library</h3>
        <p>Browse straight from folders on your disk. Ratings, flags, filters and metadata &mdash; with no import step to sit through.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3.5l8.5 4.7-8.5 4.7L3.5 8.2z"/>
          <path d="M3.5 12.6l8.5 4.7 8.5-4.7"/>
        </svg>
        <h3>Batch operations</h3>
        <p>Copy settings, sync edits and apply presets across an entire selection in one move.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4.5" width="18" height="15" rx="2"/>
          <circle cx="8.5" cy="10" r="1.8"/>
          <path d="M4 17l4.5-4.5 3.5 3.5 3-3 5 5"/>
        </svg>
        <h3>Opens your RAW files</h3>
        <p>Sony ARW, Canon CR2 / CR3 and Adobe DNG, plus JPEG and TIFF. HEIC opens in the macOS build only.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l7 3v5.5c0 4.2-2.9 7.6-7 9.5-4.1-1.9-7-5.3-7-9.5V6z"/>
          <path d="M9 12.2l2.2 2.2 4-4.4"/>
        </svg>
        <h3>Private by default</h3>
        <p>Photos are read locally and never leave your machine.</p>
      </div>
      <div class="lp-feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M13 2.5L5.5 13.5H11l-1 8 7.5-10.5H12z"/>
        </svg>
        <h3>Native decode on macOS</h3>
        <p>macOS uses the system ImageIO framework &mdash; significantly faster RAW decode and previews.</p>
      </div>
      <a
        class="lp-feature lp-feature--github"
        href="https://github.com/andrewyao/lightphotos"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View LightPhotos on GitHub (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/>
        </svg>
        <h3>GitHub</h3>
        <p class="lp-github-url">github.com/andrewyao/lightphotos</p>
      </a>
    </section>

    <section class="lp-actions" aria-label="Keep exploring">
      <a class="lp-card" href="/blogs.html">
        <i class="ph-bold ph-pencil-simple" aria-hidden="true"></i>
        <h2>Blogs <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>Write-ups on the hard parts: WebAssembly, threading, RAW decoding and color pipelines.</p>
      </a>

      <a class="lp-card" href="/docs.html">
        <i class="ph-bold ph-book-open" aria-hidden="true"></i>
        <h2>Help <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>User guides, supported formats, keyboard shortcuts and common questions.</p>
      </a>
    </section>
  </main>
</Base>
