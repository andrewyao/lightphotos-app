---
import Base from "../layouts/Base.astro";

// Build artifacts are the assets of the newest GitHub release. GitHub's
// /releases/latest/download/<file> redirect always serves the newest one, so
// the asset names must stay unversioned. Sizes are the release asset sizes in
// MiB, refreshed by hand with each release.
const RELEASES = "https://github.com/andrewyao/lightphotos/releases/latest/download";
//
// `id` names a build in the download analytics. `os` is the join key between
// this table, the per-platform CSS below and the platform sniffer in the
// inline script; builds that share one, like the two Macs, show together
// because a browser can't tell an Intel Mac from Apple Silicon. An os the
// sniffer picks that isn't here simply matches no rule, and the page falls
// back to showing every build.
//
// `label` carries the platform, so each card leads with its button instead of
// a heading that would say the same thing again. `note` is only for builds
// whose system requirements the label can't imply.

const builds = [
  {
    id: "macos-arm64",
    os: "macos",
    label: "Download for Apple Silicon",
    file: "lightphotos-macos-arm64.dmg",
    size: "6.3 MB",
    steps: [
      "Open the .dmg and drag LightPhotos into your Applications folder.",
      "Run this to clear the quarantine flag:",
    ],
    code: "xattr -dr com.apple.quarantine /Applications/LightPhotos.app",
  },
  {
    id: "macos-x86_64",
    os: "macos",
    label: "Download for Intel Mac",
    file: "lightphotos-macos-x86_64.dmg",
    size: "6.8 MB",
    steps: [
      "Open the .dmg and drag LightPhotos into your Applications folder.",
      "Run this to clear the quarantine flag:",
    ],
    code: "xattr -dr com.apple.quarantine /Applications/LightPhotos.app",
  },
  {
    id: "windows-x86_64",
    os: "windows-x86_64",
    label: "Download for Windows",
    file: "lightphotos-windows-x86_64.zip",
    size: "9.1 MB",
    steps: [
      "Unzip the archive anywhere. Inside is one lightphotos.exe, with no installer to sit through.",
      "SmartScreen warns about an unrecognized publisher the first time you run it.",
      "Choose More info, then Run anyway. You will not see it again.",
    ],
  },
  {
    id: "linux-x86_64",
    os: "linux-x86_64",
    label: "Download for Linux x86",
    note: "Ubuntu 24.04+, Debian 13, Fedora 40+",
    file: "lightphotos-linux-x86_64.tar.gz",
    size: "11.3 MB",
    steps: [
      "Extract the tarball and run the binary inside. Nothing to install, nothing to configure.",
    ],
    code: "tar xzf lightphotos-linux-x86_64.tar.gz && ./lightphotos",
  },
  {
    id: "linux-arm64",
    os: "linux-arm64",
    label: "Download for Linux ARM",
    note: "Ubuntu 24.04+, Debian 13, Fedora 40+",
    file: "lightphotos-linux-arm64.tar.gz",
    size: "10.8 MB",
    steps: [
      "Extract the tarball and run the binary inside. Nothing to install, nothing to configure.",
    ],
    code: "tar xzf lightphotos-linux-arm64.tar.gz && ./lightphotos",
  },
];

// One rule per platform, so the sniffer only has to write an os onto <html>
// and the right tiles survive. Everything that doesn't depend on which os won
// lives in lp.css.
const osCss = [...new Set(builds.map((b) => b.os))]
  .map(
    (os) => `:root[data-lp-os="${os}"] .lp-dl-grid:not(.lp-dl-grid--all) > :not([data-os="${os}"]) { display: none; }`
  )
  .join("\n");
---
<Base
  title="Download LightPhotos"
  desc="Download the LightPhotos desktop app for macOS, Windows and Linux. Native builds for Apple Silicon, x86-64 and ARM64 — free, offline and under 12 MB."
  active="downloads"
>
  <style is:inline set:html={osCss}></style>
  <script is:inline>
  // Runs before the build grid is parsed so the page never paints four tiles
  // and then blinks down to one. It only writes an id onto <html>; the CSS
  // above does the hiding, and without JS every build stays visible.
  (function () {
    var ua = navigator.userAgent || "";

    // First match wins, so the mobile bail-out and the Linux arch split have
    // to come before their broader neighbours.
    var RULES = [
      // Phones, tablets and ChromeOS get no desktop build, so they fall
      // through to the full grid and the web app note under it.
      { id: null, test: /Android|iPhone|iPad|iPod|CrOS/ },
      { id: "windows-x86_64", test: /Windows NT/ },
      { id: "macos", test: /Mac OS X|Macintosh/ },
      { id: "linux-arm64", test: /aarch64|arm64/i },
      { id: "linux-x86_64", test: /Linux|X11/ },
    ];

    function pick(ua) {
      for (var i = 0; i < RULES.length; i++) {
        if (RULES[i].test.test(ua)) return RULES[i].id;
      }
      return null;
    }

    function apply(id) {
      if (id) document.documentElement.setAttribute("data-lp-os", id);
      else document.documentElement.removeAttribute("data-lp-os");
    }

    apply(pick(ua));

    // Chromium freezes the architecture in its UA string, so a Linux ARM
    // machine claims x86_64 there. Client hints carry the truth, one async
    // hop later.
    var uad = navigator.userAgentData;
    if (uad && uad.platform === "Linux" && uad.getHighEntropyValues) {
      uad.getHighEntropyValues(["architecture"]).then(function (hints) {
        apply(hints.architecture === "arm" ? "linux-arm64" : "linux-x86_64");
      }).catch(function () {});
    }

    document.addEventListener("click", function (event) {
      // Downloads are GitHub release assets, so a click on one produces no page
      // view of its own. This is the only place the platform split gets
      // recorded. Never preventDefault here -- sendBeacon has already handed
      // the request to the browser, and the download must proceed untouched.
      var dl = event.target.closest(".lp-dl-grid .lp-btn");
      if (dl) {
        var card = dl.closest("[data-os-id]");
        if (window.lpTrack) {
          window.lpTrack("download", {
            platform: card ? card.getAttribute("data-os-id") : "unknown",
          });
        }
        return;
      }

      var btn = event.target.closest(".lp-dl-toggle");
      if (!btn) return;
      var grid = document.querySelector(".lp-dl-grid");
      var all = grid.classList.toggle("lp-dl-grid--all");
      btn.setAttribute("aria-expanded", all ? "true" : "false");
      btn.textContent = all ? "Show only my platform" : "Looking for another platform?";
    });
  })();
  </script>

  <main class="lp-page">
    <section class="lp-hero lp-hero-compact">
      <div class="lp-glow"></div>
      <h1 class="lp-wordmark">Down<span class="lp-light">loads</span></h1>
    </section>

    <p class="lp-dl-note">
      These builds are not code-signed yet, so your system asks once whether
      you really meant to open them. It takes about ten seconds, and the steps
      under each build walk you through it.
    </p>

    <section class="lp-dl-grid" aria-label="Desktop builds">
      {builds.map((b) => (
        <article class="lp-split-card" data-os-id={b.id} data-os={b.os}>
          <div class="lp-dl-foot">
            <a class="lp-btn" href={`${RELEASES}/${b.file}`}>{b.label}</a>
            <span class="lp-meta">{b.size}</span>
          </div>
          {b.note && <p class="lp-dl-req">{b.note}</p>}
          <ol class="lp-steps">
            {b.steps.map((step) => <li>{step}</li>)}
          </ol>
          {b.code && <p class="lp-code">{b.code}</p>}
        </article>
      ))}
    </section>

    <p class="lp-dl-more">
      <button type="button" class="lp-dl-toggle" aria-expanded="false">Looking for another platform?</button>
    </p>

    <div class="lp-shared">
      <span class="lp-shared-tag">Nothing here fits?</span>
      <ul class="lp-check lp-shared-list">
        <li>On something else entirely? The <a href="/app.html">web app</a> is the same editor, in any browser with WebGPU</li>
        <li>Want release notes or an older version? Every build is on the <a href="https://github.com/andrewyao/lightphotos/releases">GitHub releases page</a></li>
        <li>Found a bug or have an idea? <a href="https://github.com/andrewyao/lightphotos/issues">Open an issue on GitHub</a></li>
        <li>Either way your photos stay on disk. Your edits are saved in a small file inside a .lightphotos subfolder, so if you move a folder somewhere else, all of its edits travel with it</li>
      </ul>
    </div>
  </main>
</Base>
