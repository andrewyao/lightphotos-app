---
import Base from "../layouts/Base.astro";

// Build artifacts live in public/downloads/ and are served straight from
// /downloads/<file>. Sizes are the on-disk archive sizes, refreshed whenever a
// new build is dropped in.
//
// `id` is the join key between this table, the per-build CSS below and the
// platform sniffer in the inline script. An id the sniffer picks that isn't
// here simply matches no rule, and the page falls back to showing every build.

const builds = [
  {
    id: "macos-arm64",
    os: "macOS",
    arch: "Apple Silicon",
    note: "macOS 11 and later, M1 or newer",
    icon: "apple",
    file: "lightphotos-macos-arm64.dmg",
    size: "4.4 MB",
    steps: [
      "Open the .dmg and drag LightPhotos into Applications.",
      "Gatekeeper will refuse the first launch because the app is ad-hoc signed, not notarized.",
      "Open it once from Finder with right-click → Open, then confirm. Or clear the quarantine flag yourself:",
    ],
    code: "xattr -dr com.apple.quarantine /Applications/LightPhotos.app",
  },
  {
    id: "windows-x86_64",
    os: "Windows",
    arch: "x86-64",
    note: "Windows 10 and later, 64-bit Intel or AMD",
    icon: "windows",
    file: "lightphotos-windows-x86_64.zip",
    size: "7.6 MB",
    steps: [
      "Unzip the archive anywhere — it holds a single lightphotos.exe with no installer.",
      "SmartScreen will warn about an unrecognized publisher.",
      "Choose More info, then Run anyway.",
    ],
  },
  {
    id: "linux-x86_64",
    os: "Linux",
    arch: "x86-64",
    note: "Ubuntu 24.04+, Debian 13, Fedora 40+",
    icon: "linux",
    file: "lightphotos-linux-x86_64.tar.gz",
    size: "9.8 MB",
    steps: [
      "Extract the tarball and run the binary inside — no install step.",
    ],
    code: "tar xzf lightphotos-linux-x86_64.tar.gz && ./lightphotos",
  },
  {
    id: "linux-arm64",
    os: "Linux",
    arch: "ARM64",
    note: "Ubuntu 24.04+, Debian 13, Fedora 40+",
    icon: "linux",
    file: "lightphotos-linux-arm64.tar.gz",
    size: "9.3 MB",
    steps: [
      "Extract the tarball and run the binary inside — no install step.",
    ],
    code: "tar xzf lightphotos-linux-arm64.tar.gz && ./lightphotos",
  },
];

// One pair of rules per build, so the sniffer only has to write an id onto
// <html> and the right tile survives. Everything that doesn't depend on which
// id won lives in lp.css.
const osCss = builds
  .map(
    (b) => `:root[data-lp-os="${b.id}"] .lp-dl-grid:not(.lp-dl-grid--all) > :not([data-os-id="${b.id}"]) { display: none; }`
  )
  .join("\n");
---
<Base
  title="Download LightPhotos"
  desc="Download the LightPhotos desktop app for macOS, Windows and Linux. Native builds for Apple Silicon, x86-64 and ARM64 — free, offline and under 10 MB."
  active="downloads"
>
  <style is:inline set:html={osCss}></style>
  <script is:inline>
  // Runs before the build grid is parsed so the page never paints four tiles
  // and then blinks down to one. It only writes an id onto <html>; the CSS
  // above does the hiding, and without JS every build stays visible.
  (function () {
    var ua = navigator.userAgent || "";

    // First match wins, so the mobile bail-out and the Linux arch split have
    // to come before their broader neighbours.
    var RULES = [
      // Phones, tablets and ChromeOS get no desktop build, so they fall
      // through to the full grid and the web app note under it.
      { id: null, test: /Android|iPhone|iPad|iPod|CrOS/ },
      { id: "windows-x86_64", test: /Windows NT/ },
      { id: "macos-arm64", test: /Mac OS X|Macintosh/ },
      { id: "linux-arm64", test: /aarch64|arm64/i },
      { id: "linux-x86_64", test: /Linux|X11/ },
    ];

    function pick(ua) {
      for (var i = 0; i < RULES.length; i++) {
        if (RULES[i].test.test(ua)) return RULES[i].id;
      }
      return null;
    }

    function apply(id) {
      if (id) document.documentElement.setAttribute("data-lp-os", id);
      else document.documentElement.removeAttribute("data-lp-os");
    }

    apply(pick(ua));

    // Chromium freezes the architecture in its UA string, so a Linux ARM
    // machine claims x86_64 there. Client hints carry the truth, one async
    // hop later.
    var uad = navigator.userAgentData;
    if (uad && uad.platform === "Linux" && uad.getHighEntropyValues) {
      uad.getHighEntropyValues(["architecture"]).then(function (hints) {
        apply(hints.architecture === "arm" ? "linux-arm64" : "linux-x86_64");
      }).catch(function () {});
    }

    document.addEventListener("click", function (event) {
      var btn = event.target.closest(".lp-dl-toggle");
      if (!btn) return;
      var grid = document.querySelector(".lp-dl-grid");
      var all = grid.classList.toggle("lp-dl-grid--all");
      btn.setAttribute("aria-expanded", all ? "true" : "false");
      btn.textContent = all ? "Show only my platform" : "Show builds for other platforms";
    });
  })();
  </script>

  <main class="lp-page">
    <section class="lp-hero lp-hero-compact">
      <div class="lp-glow"></div>
      <h1 class="lp-wordmark">Down<span class="lp-light">loads</span></h1>
      <p class="lp-lede">
        The native desktop app &mdash; same editor as the web version, with a
        decode pipeline tuned to each platform. It runs entirely offline and
        never uploads a thing.
      </p>
      <p class="lp-cta-note">Free and source code coming soon &middot; no account needed</p>
    </section>

    <p class="lp-dl-note">
      None of these builds are code-signed yet, so the first launch asks once
      whether you meant to open them. Each build says what to expect.
    </p>

    <section class="lp-dl-grid" aria-label="Desktop builds">
      {builds.map((b) => (
        <article class="lp-split-card" data-os-id={b.id}>
          <div class="lp-split-head">
            {b.icon === "apple" && (
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                <path d="M16.1 12.6c0-2 1.6-3 1.7-3.1-.9-1.4-2.4-1.6-3.2-1.6-1.3-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.8-.7-1.4 0-2.7.8-3.5 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.6 2.1 1-.04 1.4-.7 2.7-.7 1.2 0 1.6.7 2.7.66 1.1-.02 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4-.03-.01-2.2-.9-2.2-3.4z"/>
                <path d="M14.1 6.3c.6-.7 1-1.7.9-2.7-.9.04-2 .6-2.6 1.4-.6.6-1.1 1.7-.9 2.6 1 .08 2-.5 2.6-1.3z"/>
              </svg>
            )}
            {b.icon === "windows" && (
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                <path d="M3.5 6.3l7.2-1v7.1H3.5z"/>
                <path d="M11.9 5.1L20.5 4v8.4h-8.6z"/>
                <path d="M3.5 13.6h7.2v7.1l-7.2-1z"/>
                <path d="M11.9 13.6h8.6V22l-8.6-1.2z"/>
              </svg>
            )}
            {b.icon === "linux" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4.5" width="18" height="15" rx="2.5"/>
                <path d="M7.5 10l2.5 2.3-2.5 2.3M13 14.6h3.5"/>
              </svg>
            )}
            <h3>{b.os}</h3>
            <span class="lp-split-tag">{b.arch}</span>
          </div>
          <p class="lp-split-lede">{b.note}</p>
          <p class="lp-dl-file">{b.file}</p>
          <div class="lp-dl-foot">
            <a class="lp-btn" href={`/downloads/${b.file}`} download>Download</a>
            <span class="lp-meta">{b.size}</span>
          </div>
          <div class="lp-dl-firstrun">
            <h4>First run</h4>
            <ol class="lp-steps">
              {b.steps.map((step) => <li>{step}</li>)}
            </ol>
            {b.code && <p class="lp-code">{b.code}</p>}
          </div>
        </article>
      ))}
    </section>

    <p class="lp-dl-more">
      <button type="button" class="lp-dl-toggle" aria-expanded="false">Show builds for other platforms</button>
    </p>

    <div class="lp-shared">
      <span class="lp-shared-tag">No build for you?</span>
      <ul class="lp-check lp-shared-list">
        <li>Intel Macs and everything else: the <a href="/app.html">web app</a> runs the same editor in any browser with WebGPU</li>
        <li>Your photos stay on disk in both versions &mdash; edits land in .lightphotos sidecars either way</li>
      </ul>
    </div>

    <section class="lp-actions" aria-label="Keep exploring">
      <a class="lp-card" href="/docs.html">
        <i class="ph-bold ph-book-open" aria-hidden="true"></i>
        <h2>Help <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>Supported formats, keyboard shortcuts and answers to the usual questions.</p>
      </a>

      <a class="lp-card" href="/blogs.html">
        <i class="ph-bold ph-pencil-simple" aria-hidden="true"></i>
        <h2>Blogs <span class="lp-go" aria-hidden="true">&rarr;</span></h2>
        <p>Write-ups on the hard parts: WebAssembly, threading, RAW decoding and color pipelines.</p>
      </a>
    </section>
  </main>
</Base>
