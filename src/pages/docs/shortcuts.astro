---
import Docs from "../../layouts/Docs.astro";

// Every row here is a string the app's own help dialog (?) shows, so this
// page can be checked against the build rather than against memory. Rows are
// grouped by what you are doing, not by which panel owns the key.
const groups = [
  {
    title: "Getting around",
    rows: [
      { key: "Cmd+O", does: "Open a different folder" },
      { key: "Enter / Space / E", does: "Open the selected photo (in the library)" },
      { key: "Esc / G", does: "Back to the library from the editor" },
      { key: "\u2190 / \u2192", does: "Previous / next photo in the editor; move the highlight in the grid" },
      { key: "Page Up / Page Down", does: "Previous / next photo in the editor" },
      { key: "D", does: "Adjust the selected photo" },
      { key: "C", does: "Compare the photos in the selected stack" },
      { key: "I", does: "Show or hide photo info in the right panel" },
      { key: "F6 / Shift+F6", does: "Next region, or the next control inside an entered one" },
      { key: "Tab / Shift+Tab", does: "Move between items in the focused region" },
      { key: "Cmd+,", does: "Settings: theme and language" },
      { key: "Alt+= / Alt+-", does: "Bigger / smaller text" },
      { key: "?", does: "Show or hide the in-app shortcut list" },
    ],
  },
  {
    title: "Rating, flags and labels",
    rows: [
      { key: "0 – 5", does: "Set the star rating (0 clears it)" },
      { key: "Shift+0 – 5", does: "Set the rating and go to the next photo" },
      { key: "P / X / U", does: "Pick / Reject / Unflag" },
      { key: "`", does: "Pick, or unflag a picked photo" },
      { key: "6 / 7 / 8 / 9", does: "Red / yellow / green / blue label; the same key again clears it" },
    ],
  },
  {
    title: "Selecting and stacking",
    rows: [
      { key: "Cmd+A", does: "Select all in the current folder (in the library)" },
      { key: "Cmd+D", does: "Deselect all" },
      { key: "Shift+Click", does: "Range-select in the grid" },
      { key: "Cmd+Click", does: "Toggle one photo in or out of the selection" },
      { key: "Shift+Arrows", does: "Extend the selection with the arrow keys" },
      { key: "Cmd+G", does: "Stack the selection" },
      { key: "Cmd+Shift+G", does: "Unstack the selected stacks" },
      { key: "Shift+Delete", does: "Delete the selected stacks, or unstack them and keep the photos" },
    ],
  },
  {
    title: "Zoom and pan",
    rows: [
      { key: "Space / Z", does: "Cycle zoom: fit, 2x fit, 100%" },
      { key: "Cmd++ / Cmd+= / Cmd+-", does: "Zoom in / out in 20% steps" },
      { key: "\u2191 / \u2193", does: "Zoom in / out in 10% steps" },
      { key: "Scroll", does: "Zoom at the pointer" },
      { key: "Drag / Space+Drag", does: "Pan" },
      { key: "Shift+Scroll", does: "Pan sideways" },
      { key: "Alt+Scroll", does: "Pan up and down" },
    ],
  },
  {
    title: "Developing and exporting",
    rows: [
      { key: "Cmd+[ / Cmd+]", does: "Rotate -90 / +90 degrees" },
      { key: "R", does: "Crop; Enter or R applies it, Esc cancels" },
      { key: "Y", does: "Before / after compare (in the editor)" },
      { key: "Cmd+U", does: "Auto Adjust this photo from its own histogram" },
      { key: "Cmd+Shift+C", does: "Copy this photo's adjustment" },
      { key: "Cmd+Shift+V", does: "Apply the copied adjustment to the selection" },
      { key: "Cmd+Shift+E", does: "Open or close the export form" },
      { key: "Double-click a slider", does: "Reset the slider" },
      { key: "Delete", does: "Move to the Trash (in the browser: delete permanently, with no undo)" },
    ],
  },
  {
    title: "Cleanup",
    rows: [
      { key: "K", does: "Open the Cleanup tab" },
      { key: "Q", does: "Touch Up on / off" },
      { key: "[ / ]", does: "Brush size (or scroll)" },
      { key: "Shift+[ / ]", does: "Brush feather (or Shift+Scroll)" },
      { key: "O / Shift+O", does: "Show or hide the spots / select the next spot" },
      { key: "Delete", does: "Delete the selected spot" },
      { key: "Cmd+Z", does: "Undo the last spot" },
      { key: "Esc", does: "Leave Touch Up" },
    ],
  },
  {
    title: "Choosing a representative",
    rows: [
      { key: "Click or drag the photo", does: "Move the focus area" },
      { key: "Shift+Scroll on the area", does: "Resize the focus area" },
      { key: "Drag a tile", does: "Move the focus area" },
      { key: "Cmd+Click / Shift+Click a tile", does: "Pick more tiles" },
    ],
  },
  {
    title: "Subject selection (macOS app only)",
    rows: [
      { key: "O", does: "Show or hide the subject selection" },
      { key: "Shift+O", does: "Invert the subject selection" },
    ],
  },
];
---
<Docs slug="shortcuts">
  <p>
    LightPhotos is built to be driven from the keyboard: rate a folder without
    touching the mouse, move through a shoot at full size, and apply one
    photo's look to the rest. The list below is everything the app listens
    for, and <kbd>?</kbd> shows the same list in-app on your own machine.
  </p>

  {groups.map((g) => (
    <section>
      <h2>{g.title}</h2>
      <div class="lp-compare-wrap">
        <table class="lp-compare">
          <thead>
            <tr>
              <th scope="col">Key</th>
              <th scope="col">Does</th>
            </tr>
          </thead>
          <tbody>
            {g.rows.map((r) => (
              <tr>
                <td><kbd>{r.key}</kbd></td>
                <td>{r.does}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Docs>
