  <script is:inline>
    (function () {
      var STORAGE_KEY = 'lp-post-sort';
      var list = document.querySelector('.lp-post-list');
      var buttons = document.querySelectorAll('.lp-post-sort button[data-sort]');
      if (!list || !buttons.length) return;
      // The markup lists posts newest first; oldest first is that order reversed.
      var newest = Array.prototype.slice.call(list.children);

      function apply(order) {
        var items = order === 'oldest' ? newest.slice().reverse() : newest;
        items.forEach(function (li) { list.appendChild(li); });
        buttons.forEach(function (btn) {
          btn.setAttribute('aria-pressed', btn.getAttribute('data-sort') === order ? 'true' : 'false');
        });
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var order = btn.getAttribute('data-sort');
          apply(order);
          try { localStorage.setItem(STORAGE_KEY, order); } catch (e) {}
        });
      });

      try {
        if (localStorage.getItem(STORAGE_KEY) === 'oldest') apply('oldest');
      } catch (e) {}
    })();
  </script>
