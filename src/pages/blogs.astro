---
import Base from "../layouts/Base.astro";
---
<Base
  title="LightPhotos Blog"
  desc="Write-ups on why LightPhotos exists and how it's built."
  active="blogs"
>
  <main class="lp-page">
    <section class="lp-hero lp-hero-compact">
      <div class="lp-glow"></div>
      <h1 class="lp-wordmark">Blog</h1>
      <p class="lp-lede">
        Notes on why LightPhotos exists and how it's built.
      </p>
    </section>

    <ul class="lp-post-list">
      <li>
        <a href="/blogs/why-i-started-lightphotos.html">
          <time datetime="2026-06-23">June 23, 2026</time>
          <h2>Why I started LightPhotos</h2>
          <p>A Lightroom license that stopped working, a few apps that didn't fit, and an afternoon spent building the small photo editor I actually needed.</p>
        </a>
      </li>
    </ul>
  </main>
</Base>
