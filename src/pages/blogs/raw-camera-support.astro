---
import Base from "../../layouts/Base.astro";
import samples from "../../../public/raw-bench/samples-2026-10-15.json";
import report from "../../../public/raw-bench/2026-10-15-display-2560-detail.json";
import fullReport from "../../../public/raw-bench/2026-10-15-display-full-detail.json";

const engines = [
  {
    id: "apple", name: "Apple RAW",
    steps: [["Open RAW file", "Input"], ["Develop at preview size", "Apple RAW"], ["Render base color", "GPU"], ["Sharpen + color NR", "GPU"], ["2560 px RGBA", "Output"]],
    reason: "Apple renders at the preview size. The same shared GPU detail pass then sharpens the image and reduces color noise.",
  },
  {
    id: "rawler", name: "rawler 0.8.0",
    steps: [["Unpack sensor data", "CPU"], ["Develop + resize", "CPU"], ["Convert base color", "CPU"], ["Sharpen + color NR", "GPU"], ["2560 px RGBA", "Output"]],
    reason: "Rawler develops the full image, then shrinks it on the CPU. This test adds the same shared GPU detail pass as the other engines.",
  },
  {
    id: "lightcraft", name: "LightCraft RAW",
    steps: [["Unpack sensor data", "CPU"], ["Reduce + develop", "CPU"], ["Render base color", "GPU"], ["Sharpen + color NR", "GPU"], ["2560 px RGBA", "Output"]],
    reason: "LightCraft can reduce sensor data first. Its native detail filters are off; it uses the same shared GPU pass as the other engines.",
  },
];
const resolutions = [
  { id: "preview", name: "2560 px preview", report },
  { id: "full", name: "Full resolution", report: fullReport },
];
const longest = Math.max(...resolutions.flatMap(resolution => Object.values(resolution.report.common_sum_of_medians_ms)));
const result = (data, file, engine) => data.records.find(r => r.file === file && r.engine === engine);
const stepsFor = (engine, resolution) => resolution === "preview" ? engine.steps : [
  engine.steps[0],
  ["Develop at full size", engine.id === "apple" ? "Apple RAW" : "CPU"],
  engine.steps[2],
  engine.steps[3],
  ["Full-size RGBA", "Output"],
];
const fullReasons = {
  apple: "Apple develops at full size, then uses the shared GPU detail pass. Its adjustable native detail filters are off where supported.",
  rawler: "Rawler develops the full image on the CPU without a preview resize. The shared GPU pass then applies sharpening and color noise reduction.",
  lightcraft: "LightCraft develops at full size without sensor binning, then uses the shared GPU detail pass. Its native detail filters are off.",
};
const passed = (engine) => report.records.filter(r => r.engine === engine && r.successes === r.attempts).length;
const seconds = (value) => `${(value / 1000).toFixed(2)} s`;
const milliseconds = (value) => `${value.toFixed(1)} ms`;
const charts = [
  { id: "failed", title: "Decode failures", note: `Out of ${samples.length} RAW files · lower is better`, max: samples.length,
    values: engines.map(engine => ({ ...engine, value: samples.length - passed(engine.id), label: `${samples.length - passed(engine.id)} / ${samples.length}` })) },
  ...resolutions.map(resolution => ({
    id: resolution.id, title: resolution.id === "preview" ? "Time for preview" : "Time for full resolution",
    note: `${resolution.name} · same ${resolution.report.common_files.length} files · lower is better`,
    max: Math.ceil(Math.max(...Object.values(resolution.report.common_sum_of_medians_ms)) / 1000) * 1000,
    values: engines.map(engine => ({ ...engine, value: resolution.report.common_sum_of_medians_ms[engine.id], label: seconds(resolution.report.common_sum_of_medians_ms[engine.id]) })),
  })),
];
---
<Base
  title="Which cameras do LightPhotos and LightCraft support? — LightPhotos Blog"
  desc="18 RAW files and three engines, with the same GPU sharpening and color noise reduction. Preview and full-size timings, camera support, and an interactive processing diagram."
  active="blogs"
>
  <main class="lp-page">
    <article class="lp-article">
      <header class="lp-article-head">
        <p class="lp-article-meta"><a href="/blogs.html">Blogs</a> &middot; <time datetime="2026-10-15">October 15, 2026</time></p>
        <h1>Which cameras do LightPhotos and LightCraft support?</h1>
        <p class="lp-article-dek">
          I tested 18 RAW files at preview and full size. Every engine used the
          same sharpening and color noise reduction. The camera setting matters.
          So does the path from sensor data to screen pixels.
        </p>
        <p class="lp-article-byline">Andrew Yao &middot; 4 min read</p>
      </header>

      <aside class="lp-tldr">
        <p class="lp-tldr-label">TL;DR</p>
        <p>
          Apple decoded {passed("apple")} files, rawler {passed("rawler")}, and
          LightCraft {passed("lightcraft")} of 18. For the same 16 previews,
          Apple took {seconds(report.common_sum_of_medians_ms.apple)},
          rawler {seconds(report.common_sum_of_medians_ms.rawler)}, and
          LightCraft {seconds(report.common_sum_of_medians_ms.lightcraft)}.
          At full size, the times were {seconds(fullReport.common_sum_of_medians_ms.apple)},
          {seconds(fullReport.common_sum_of_medians_ms.rawler)}, and
          {seconds(fullReport.common_sum_of_medians_ms.lightcraft)} in the same order.
          All three include the same GPU detail filters.
        </p>
      </aside>

      <figure class="lp-figure lp-try raw-architecture" id="raw-architecture">
        <div class="lp-try-controls" role="group" aria-label="Choose output size for the diagram and detailed results">
          {resolutions.map((resolution, index) => <button type="button" class="lp-try-btn" data-resolution={resolution.id}
            aria-pressed={index === 0 ? "true" : "false"} aria-controls="route-panels">
            {resolution.name}
          </button>)}
        </div>
        <div class="lp-try-controls" role="group" aria-label="Choose a RAW engine">
          {engines.map((engine, index) => <button type="button" class="lp-try-btn" data-engine={engine.id}
            aria-pressed={index === 0 ? "true" : "false"} aria-controls={`route-${engine.id}`}>
            {engine.name}
          </button>)}
        </div>
        <div class="route-panels" id="route-panels" aria-live="polite" aria-atomic="true">
          {engines.map((engine, index) => <div id={`route-${engine.id}`} data-route={engine.id} hidden={index !== 0}>
            {resolutions.map((resolution, sizeIndex) => <div data-resolution-panel={resolution.id} hidden={sizeIndex !== 0}>
              <ol class="route-steps" aria-label={`${engine.name}, ${resolution.name} processing path`}>
                {stepsFor(engine, resolution.id).map(([label, device]) => <li class:list={["route-step", { "route-gpu": device === "GPU", "route-output": device === "Output" }]}>
                  <span class="route-device">{device}</span>
                  <strong>{label}</strong>
                </li>)}
              </ol>
              <p class="route-reason">{resolution.id === "preview" ? engine.reason : fullReasons[engine.id]}</p>
              <div class="route-time">
                <span>Same {resolution.report.common_files.length} files · {resolution.name}</span>
                <strong>{seconds(resolution.report.common_sum_of_medians_ms[engine.id])}</strong>
              </div>
              <div class="route-track" aria-hidden="true"><div class="route-fill" style={`width: ${100 * resolution.report.common_sum_of_medians_ms[engine.id] / longest}%`}></div></div>
            </div>)}
          </div>)}
        </div>
        <figcaption>Select a size and an engine. A shorter bar means less time for the shared files at that size.</figcaption>
      </figure>

      <p>
        LightCraft has its own RAW engine. I tested
        each engine with the same files at two sizes: a 2560-pixel preview and
        full resolution. Both tests produce RGBA display pixels with sharpening and color noise reduction.
      </p>

      <h2>The result</h2>
      <p>
        <strong>LightPhotos uses Apple's Core Image on Mac and rawler on other
        platforms (Windows, Linux and the browser).</strong>
        The Apple RAW and rawler bars below show those two engines.
      </p>
      <div class="raw-charts">
        {charts.map(chart => <figure class="raw-chart" aria-labelledby={`chart-${chart.id}`}>
          <figcaption>
            <h3 id={`chart-${chart.id}`}>{chart.title}</h3>
            <p>{chart.note}</p>
          </figcaption>
          <ul class="raw-chart-bars">
            {chart.values.map(engine => <li data-chart-engine={engine.id}>
              <div class="raw-chart-label"><span>{engine.name}</span><strong>{engine.label}</strong></div>
              <div class="raw-chart-track" aria-hidden="true"><div class="raw-chart-fill" style={`width: ${100 * engine.value / chart.max}%`}></div></div>
            </li>)}
          </ul>
          <div class="raw-chart-axis" aria-hidden="true"><span>0</span><span>{chart.id === "failed" ? chart.max : seconds(chart.max)}</span></div>
        </figure>)}
      </div>
      <p class="raw-chart-machine">Mac mini, Apple M4, 16 GB RAM, macOS 26.5.2</p>
      <p>
        Both time charts use the same 16 files decoded by all three engines.
        Each total adds the median times from five runs per file. Failed files
        do not count as zero time. Full resolution means the original file's
        developed dimensions; there is no preview reduction.
      </p>

      <h2>Why the times differ</h2>
      <p>
        Rawler develops the full image on the CPU before it makes a preview.
        Apple can develop at the requested size. LightCraft can reduce the sensor
        data first. After base color rendering, all three use the same GPU pass:
        sharpening at 40 and color noise reduction at 25.
      </p>

      <p>
        Rawler has no built-in GPU mode. The test adds a GPU detail pass after
        its CPU development. This is a controlled test path, not the complete
        LightPhotos path. LightPhotos also has faster preview paths in the browser.
      </p>
      <p>
        At full size, preview reduction is off. Rawler can skip its preview resize,
        but all engines must process more pixels in the shared detail pass. The
        filters and settings match; the RAW color and tone rendering still differ.
      </p>

      <h2>Check the camera and the setting</h2>
      <ul class="lp-article-list">
        <li><strong>Nikon Z f:</strong> lossless NEF worked in all three. High Efficiency NEF worked only in Apple RAW.</li>
        <li><strong>Olympus:</strong> the E-1 file worked in all three. The E-M1's compressed ORF failed in LightCraft.</li>
        <li><strong>Fujifilm:</strong> both compressed X-T5 files worked in all three engines. LightPhotos still has separate X-Trans preview limits. A decoder pass does not prove that every app feature works.</li>
      </ul>
      <p>
        A JPEG preview inside a RAW file does not count as a sensor decode.
        These results apply to the files tested, not every mode from each camera.
        Apple's column uses Core Image first, as LightPhotos does. All files
        passed that path, so its ImageIO fallback was not needed.
      </p>

      <details class="raw-details">
        <summary>See all 18 files and their render times</summary>
        <p>Use the size buttons in the diagram to switch this table.</p>
        {resolutions.map((resolution, index) => <div data-resolution-panel={resolution.id} hidden={index !== 0}>
          <div class="lp-compare-wrap raw-table">
            <table class="lp-compare">
              <caption>{resolution.name}, RGBA output; median of five runs</caption>
              <thead><tr><th scope="col">Camera and mode</th>{engines.map(engine => <th scope="col">{engine.name}</th>)}</tr></thead>
              <tbody>{samples.map(sample => <tr>
                <th scope="row">{sample.camera}<small>{sample.mode}</small></th>
                {engines.map(engine => {
                  const r = result(resolution.report, sample.file, engine.id);
                  return <td>{r.successes === r.attempts ? milliseconds(r.median_ms) : "Failed"}</td>;
                })}
              </tr>)}</tbody>
            </table>
          </div>
        </div>)}
      </details>

      <h2>What this test measures</h2>
      <p>
        All engines returned the same image size and pixel format. Workers stayed
        open. Apple reused its render context. Each engine had a warm-up pass.
        We then ran five rounds in a mixed order, with warm file caches and no
        saved image results. Time includes reading the file, RAW processing,
        any resize and the transfer of GPU results to memory. Full-resolution
        runs disable preview scaling and sensor binning.
      </p>
      <p>
        Apple's adjustable detail filters are off where supported. LightCraft's
        native detail filters are also off. We then apply the same GPU sharpening
        and color noise reduction to each output, with the same settings and
        working color space. This does not remove processing already baked into
        a camera file or make the RAW colors identical.
      </p>
      <p>
        The time adds RAW conversion and the shared detail pass. Moving pixels
        between the test programs is not timed; all three use the same handoff.
        This compares controlled processing work, not equal final quality or the
        speed of either app with its normal defaults.
      </p>
      <p class="raw-sources">
        For more cameras, see the support lists from
        <a href="https://support.apple.com/en-us/122870">Apple for macOS 26</a>,
        <a href="https://github.com/dnglab/dnglab/tree/v0.8.0/rawler/data/cameras">rawler</a>
        and <a href="https://github.com/storytold/lightcraft/blob/main/docs/raw/coverage.tsv">LightCraft</a>.
        The source photos are public CC0 files from <a href="https://raw.pixls.us/">raw.pixls.us</a>.
      </p>

      <nav class="lp-article-nav" aria-label="More posts">
        <a class="lp-article-nav-prev" href="/blogs/catalogs.html">
          <span class="lp-article-nav-dir">Back</span>
          <span class="lp-article-nav-title">Catalogs, a first version</span>
        </a>
        <a class="lp-article-nav-next" href="/blogs/two-raw-decoders.html">
          <span class="lp-article-nav-dir">Next</span>
          <span class="lp-article-nav-title">Two RAW decoders, side by side</span>
        </a>
      </nav>
    </article>
  </main>
  <script>
    const diagram = document.getElementById("raw-architecture");
    if (diagram) {
      const buttons = diagram.querySelectorAll("button[data-engine]");
      const sizes = diagram.querySelectorAll("button[data-resolution]");
      const routes = diagram.querySelectorAll("[data-route]");
      const panels = diagram.closest("article").querySelectorAll("[data-resolution-panel]");
      buttons.forEach(button => {
        button.addEventListener("click", () => {
          const selected = button.getAttribute("data-engine");
          buttons.forEach(item => item.setAttribute("aria-pressed", String(item === button)));
          routes.forEach(route => {
            route.toggleAttribute("hidden", route.getAttribute("data-route") !== selected);
          });
        });
      });
      sizes.forEach(button => {
        button.addEventListener("click", () => {
          const selected = button.getAttribute("data-resolution");
          sizes.forEach(item => item.setAttribute("aria-pressed", String(item === button)));
          panels.forEach(panel => {
            panel.toggleAttribute("hidden", panel.getAttribute("data-resolution-panel") !== selected);
          });
        });
      });
    }
  </script>
</Base>

<style>
  .raw-charts { display: grid; gap: 1.25rem; margin: 1.5rem 0 .75rem; }
  .raw-chart { margin: 0; padding: 1.25rem; border: 1px solid var(--border-strong); border-radius: 8px; }
  .raw-chart h3 { margin: 0; font-size: 1.1rem; }
  .raw-chart figcaption p { margin: .35rem 0 1.25rem; font-size: .8rem; color: var(--text-secondary); }
  .raw-chart-bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .raw-chart-label { display: flex; justify-content: space-between; gap: .75rem; margin-bottom: .4rem; font-size: .85rem; }
  .raw-chart-label strong { font-family: var(--font-mono); white-space: nowrap; }
  .raw-chart-track { background: var(--surface-input); height: 20px; border-left: 1px solid var(--border-strong); }
  .raw-chart-fill { height: 100%; background: var(--text-link); }
  [data-chart-engine="rawler"] .raw-chart-fill { background: #b389df; }
  [data-chart-engine="lightcraft"] .raw-chart-fill { background: #54bfa5; }
  .raw-chart-axis { display: flex; justify-content: space-between; margin-top: .5rem; font-family: var(--font-mono); font-size: .7rem; color: var(--text-secondary); }
  .raw-chart-machine { font-size: .8rem; color: var(--text-secondary); }
  .raw-table { overflow-x: auto; }
  .raw-table table { width: 100%; }
  .raw-table th, .raw-table td { vertical-align: top; }
  .raw-table small { display: block; font-weight: 400; color: var(--text-secondary); margin-top: .25rem; }
  .raw-table caption { text-align: left; padding: .8rem 0; font-size: .85rem; }
  .raw-table td { white-space: nowrap; }
  .route-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; list-style: none; padding: 0; margin: 0; }
  .route-step { position: relative; display: flex; flex-direction: column; gap: .65rem; padding: .85rem .65rem; border: 1px solid var(--border-strong); border-radius: 8px; min-width: 0; }
  .route-step:not(:last-child)::after { content: "→"; position: absolute; right: -.9rem; top: 50%; transform: translateY(-50%); color: var(--text-secondary); }
  .route-step strong { font-size: .85rem; line-height: 1.4; }
  .route-device { font-family: var(--font-mono); font-size: .7rem; color: var(--text-secondary); }
  .route-gpu { background: var(--lp-glow-soft); border-color: var(--border-accent); }
  .route-gpu .route-device { color: var(--text-link); }
  .route-output { border-style: dashed; }
  .route-reason { min-height: 4.5em; font-size: .9rem; line-height: 1.5; margin: 1rem 0; }
  .route-time { display: flex; justify-content: space-between; gap: 1rem; font-size: .85rem; }
  .route-time strong { font-family: var(--font-mono); }
  .route-track { height: 8px; background: var(--surface-input); border-radius: 4px; margin-top: .6rem; overflow: hidden; }
  .route-fill { height: 100%; background: var(--text-link); border-radius: inherit; }
  .raw-details { margin: 1.5rem 0 2rem; }
  .raw-details summary { cursor: pointer; font-weight: 600; }
  .raw-sources { font-size: .9rem; }
  @media (max-width: 540px) {
    .route-steps { grid-template-columns: 1fr; gap: 1.1rem; }
    .route-step { flex-direction: row; align-items: baseline; gap: .8rem; padding: .65rem .8rem; }
    .route-device { min-width: 5rem; }
    .route-step:not(:last-child)::after { content: "↓"; top: auto; bottom: -1.15rem; right: 50%; transform: translateX(50%); }
    .route-reason { min-height: 0; }
  }
</style>
