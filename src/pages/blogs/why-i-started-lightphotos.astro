          <g data-row data-fails="4" opacity="0.55">
            <rect class="lp-fig-box-accent" x="1" y="192" width="638" height="28" rx="5" opacity="0"></rect>
            <text class="lp-fig-t" x="10" y="211">Lightroom subscription</text>
            <circle class="lp-fig-line-soft" data-col="0" cx="240" cy="206" r="4"></circle>
            <circle class="lp-fig-line-soft" data-col="1" cx="328" cy="206" r="4"></circle>
            <circle class="lp-fig-line-soft" data-col="2" cx="416" cy="206" r="4"></circle>
            <circle class="lp-fig-line-soft" data-col="3" cx="504" cy="206" r="4"></circle>
            <circle class="lp-fig-bad" data-col="4" cx="592" cy="206" r="5"></circle>
