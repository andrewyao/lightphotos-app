  </main>
  <script>
    const fig = document.getElementById("handoff-demo");
    if (fig) {
      const LABELS = {
        rust: ["Slider moves", "Edit function", "New pixels"],
        split: ["Slider moves (JS)", "Engine (Rust)", "New pixels (JS)"],
      };
      const NOTES = {
        rust: "No runtime boundary. It is a function call.",
        split: "Two boundary crosses per frame, 120 a second.",
      };
      const NAMES = { rust: "All Rust", split: "Rust engine + web UI" };
      const modeBtns = [...fig.querySelectorAll("[data-mode]")];
      const slider = fig.querySelector("[data-drag]");
      const runBtn = fig.querySelector("[data-run]");
      const ticks = [...fig.querySelectorAll("[data-tick]")];
      const crosses = [...fig.querySelectorAll("[data-cross]")];
      const note = fig.querySelector("[data-note]");
      const readout = fig.querySelector(".lp-try-readout");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let mode = "rust";
      let frames = 0;
      let running = false;

      function clearTicks() {
        ticks.forEach((t) => {
          t.setAttribute("class", "lp-fig-bar-dim");
          t.setAttribute("opacity", "0.35");
        });
        crosses.forEach((c) => c.setAttribute("opacity", "0"));
      }

      function report() {
        const perFrame = mode === "split" ? 2 : 0;
        readout.textContent = `${NAMES[mode]}: ${frames} frames, ${frames * perFrame} boundary crosses.`;
      }

      function frame() {
        const i = frames % 60;
        if (i === 0) clearTicks();
        ticks[i].setAttribute("class", "lp-fig-bar");
        ticks[i].setAttribute("opacity", "1");
        if (mode === "split") {
          crosses[i * 2].setAttribute("opacity", "1");
          crosses[i * 2 + 1].setAttribute("opacity", "1");
        }
        frames++;
        report();
      }

      function setMode(next) {
        mode = next;
        frames = 0;
        modeBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === mode)));
        fig.querySelectorAll("[data-label]").forEach((t) => {
          t.textContent = LABELS[mode][+t.dataset.label];
        });
        fig.querySelector("[data-split]").setAttribute("opacity", mode === "split" ? "1" : "0");
        note.textContent = NOTES[mode];
        clearTicks();
        report();
      }

      modeBtns.forEach((b) => b.addEventListener("click", () => setMode(b.dataset.mode)));
      slider.addEventListener("input", () => {
        if (!running) frame();
      });

      runBtn.addEventListener("click", () => {
        if (running) return;
        frames = 0;
        if (reduceMotion.matches) {
          for (let n = 0; n < 60; n++) frame();
          return;
        }
        running = true;
        runBtn.disabled = true;
        const start = performance.now();
        function step(now) {
          const due = Math.min(60, Math.floor(((now - start) / 1000) * 60) + 1);
          while (frames < due) {
            frame();
            slider.value = String(50 + Math.round(40 * Math.sin((frames / 60) * Math.PI * 2)));
          }
          if (frames < 60) {
            requestAnimationFrame(step);
          } else {
            running = false;
            runBtn.disabled = false;
          }
        }
        requestAnimationFrame(step);
      });
    }
  </script>
