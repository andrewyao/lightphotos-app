---
import Base from "../../layouts/Base.astro";
---
<Base
  title="Exporting to your own Immich server — LightPhotos Blog"
  desc="LightPhotos can upload finished photos straight to any Immich server, even one on a box in your home. Here is how I made your server address and an API key work with no extra steps."
  active="blogs"
>
  <main class="lp-page">
    <article class="lp-article">
      <header class="lp-article-head">
        <p class="lp-article-meta"><a href="/blogs.html">Blogs</a> &middot; <time datetime="2026-09-26">September 26, 2026</time></p>
        <h1>Exporting to your own Immich server</h1>
        <p class="lp-article-dek">
          LightPhotos can upload finished photos straight to any Immich server,
          even one on a box in your home. Here is how I made your server address
          and an API key work with no extra steps.
        </p>
        <p class="lp-article-byline">Andrew Yao &middot; 5 min read</p>
      </header>

      <aside class="lp-tldr">
        <p class="lp-tldr-label">TL;DR</p>
        <p>
          Immich is a photo library that you host yourself, the nearest
          equivalent to Google Photos that you can run on your own hardware.
          The LightPhotos export form now has an Immich destination. Paste your server
          address and an API key (a token, similar to a password, from your
          server), then click Connect. LightPhotos sends your edited JPEGs to
          your server with their capture time and star rating.
        </p>
        <p>
          Most of the work was around the upload: accept any address, check
          the key early, survive slow home internet, and never send a key
          unencrypted by accident. This feature is only in the desktop app,
          because browsers cannot talk to an Immich server.
        </p>
      </aside>

      <figure class="lp-figure lp-try" id="immich-connect">
        <div class="lp-try-controls">
          <span role="group" aria-label="Address" style="display:inline-flex;flex-wrap:wrap;align-items:center;gap:0.5rem">
          <span>You type:</span>
          <button type="button" class="lp-try-btn" data-addr="0" aria-pressed="true">photos.example.com</button>
          <button type="button" class="lp-try-btn" data-addr="1" aria-pressed="false">https://photos.example.com/api/</button>
          <button type="button" class="lp-try-btn" data-addr="2" aria-pressed="false">http://nas.local:2283</button>
          </span>
          <span role="group" aria-label="Key" style="display:inline-flex;flex-wrap:wrap;align-items:center;gap:0.5rem">
          <span>Key:</span>
          <button type="button" class="lp-try-btn" data-key="real" aria-pressed="true">Real key</button>
          <button type="button" class="lp-try-btn" data-key="fake" aria-pressed="false">Invented key</button>
          </span>
          <span role="group" aria-label="Check" style="display:inline-flex;flex-wrap:wrap;align-items:center;gap:0.5rem">
          <span>Check with:</span>
          <button type="button" class="lp-try-btn" data-check="me" aria-pressed="true">Who owns this key?</button>
          <button type="button" class="lp-try-btn" data-check="about" aria-pressed="false">About this server</button>
          </span>
        </div>
        <svg viewBox="0 0 640 236" role="img" aria-label="The three steps from a typed address to a saved key, and the result.">
          <rect class="lp-fig-box" x="0" y="0" width="180" height="50" rx="5"></rect>
          <text class="lp-fig-t" x="12" y="21">1. Clean the address</text>
          <text class="lp-fig-s" x="12" y="39">trim, drop / and /api</text>
          <text class="lp-fig-s" x="196" y="20">typed</text>
          <text class="lp-fig-t lp-fig-mono" data-el="typed" x="250" y="20">photos.example.com</text>
          <text class="lp-fig-s" x="196" y="40">clean</text>
          <text class="lp-fig-t lp-fig-mono" data-el="clean" x="250" y="40">https://photos.example.com</text>

          <rect class="lp-fig-box" x="0" y="60" width="180" height="50" rx="5"></rect>
          <text class="lp-fig-t" x="12" y="81">2. Find the API</text>
          <text class="lp-fig-s lp-fig-mono" x="12" y="99">/.well-known/immich</text>
          <text class="lp-fig-s" x="196" y="80">else</text>
          <text class="lp-fig-t lp-fig-mono" x="250" y="80">/api</text>
          <text class="lp-fig-s" x="196" y="100">API</text>
          <text class="lp-fig-t lp-fig-mono" data-el="api" x="250" y="100">https://photos.example.com/api</text>

          <rect class="lp-fig-box" x="0" y="120" width="180" height="50" rx="5"></rect>
          <text class="lp-fig-t" x="12" y="141">3. Check the key</text>
          <text class="lp-fig-s" x="12" y="159">before anything is saved</text>
          <text class="lp-fig-s" x="196" y="140">ask</text>
          <text class="lp-fig-t lp-fig-mono" data-el="ask" x="250" y="140">GET /users/me</text>
          <text class="lp-fig-s" x="196" y="160">reply</text>
          <text class="lp-fig-t" data-el="reply" x="250" y="160">&ldquo;Connected as&rdquo; your name and email</text>

          <line class="lp-fig-line" x1="90" y1="170" x2="90" y2="184"></line>
          <path class="lp-fig-arrow" d="M85 184 L95 184 L90 192 Z"></path>
          <rect class="lp-fig-box-accent" data-el="result-box" x="0" y="192" width="640" height="40" rx="5"></rect>
          <circle class="lp-fig-good" data-el="result-dot" cx="16" cy="212" r="4"></circle>
          <text class="lp-fig-t" data-el="result" x="30" y="217">Saves the address and the key.</text>
        </svg>
        <p class="lp-try-readout" aria-live="polite">No scheme typed, so LightPhotos adds https://.</p>
        <figcaption>
          Pick an address, a key and a check. Then try the invented key with
          each check.
        </figcaption>
      </figure>

      <h2>Why Immich</h2>
      <p>
        I keep my originals in folders on a drive, and I will not change
        that. But nobody wants to browse a folder of JPEGs on a phone, and I
        will not give my photos to a service that I cannot leave. Immich is a
        real photo library with a phone app, on my own hardware or a hosted
        service. Before, I exported to a folder and uploaded it by hand. Now
        it is one step.
      </p>

      <h2>Accept any address that you type</h2>
      <p>
        People type <code>photos.example.com</code>, paste
        <code>https://photos.example.com/api/</code> from the documentation,
        or use <code>http://nas.local:2283</code> at home. All must work.
        LightPhotos trims spaces, removes a trailing slash or
        <code>/api</code>, and adds <code>https://</code> if you left it off.
        Then it reads the discovery file of the server,
        <code>/.well-known/immich</code>, to find where the API lives. That
        helps people who host Immich under a sub-path, for example
        <code>/immich/api</code>. With no discovery file, it uses the usual
        <code>/api</code>.
      </p>
      <p>
        If you type no scheme and HTTPS fails, LightPhotos does not silently
        fall back to plain HTTP, because that would send your API key across
        the network without encryption and without telling you. The error
        tells you to type <code>http://</code> yourself if your server has no
        HTTPS. The decision is yours.
      </p>

      <h2>Check the key early</h2>
      <p>
        The usual connection test asks the server about itself. Gumnut, a
        hosted Immich service, answered that request for any key, even one
        that I invented. A wrong key looked fine until the first upload
        failed. So LightPhotos asks "who owns this key?" instead. Only a real
        key gets a reply, and the reply also gives the form "Connected as"
        with your name and email. Check a key with a request that needs the
        key.
      </p>
      <p>
        LightPhotos saves nothing until that check passes. The address goes
        in the app settings. The key goes somewhere safer:
      </p>
      <ul class="lp-article-list">
        <li><strong>Mac:</strong> your login Keychain, one entry for each server.</li>
        <li><strong>Linux:</strong> a file in the app config folder that only your user can read.</li>
        <li><strong>Windows:</strong> a file in your own app data folder.</li>
      </ul>
      <p>
        LightPhotos does not touch the Keychain until you open the Immich
        tab, so if you never use Immich, you never see a Keychain prompt.
      </p>

      <h2>What LightPhotos uploads</h2>
      <p>
        Immich gets the finished JPEG, rendered exactly as for a folder
        export with your edits, crop and size. Your originals stay on your
        drive. Two items go with it:
      </p>
      <ul class="lp-article-list">
        <li>
          <strong>The capture time, with its time zone.</strong> My first
          version read the camera clock as UTC, so a photo taken at
          6&nbsp;pm in California appeared in Immich at 11&nbsp;am. Now each
          export sends its capture time plus the time-zone offset of the
          camera. It falls back to the file date only when the camera did not
          record a capture time.
        </li>
        <li>
          <strong>Your star rating,</strong> set immediately after the
          upload. Some keys have permission to upload but not to change
          photos. With such a key, the photo still uploads and you get a
          warning about the rating instead of a failed export.
        </li>
      </ul>

      <h2>Running the same batch twice</h2>
      <p>
        An export can stop early when the laptop sleeps or the Wi-Fi drops.
        The easiest fix is to export again, so that must be safe. I let the
        server find duplicates. If you upload the same file twice, Immich
        replies "duplicate" and points to the photo that it already has.
        LightPhotos keeps no upload list that could fall out of sync with the
        server. It sends everything again, counts the duplicates and shows a
        message such as "Uploaded 40 photos, 32 already on the server."
        The batch picks up where it stopped.
      </p>

      <h2>Slow uploads that still work</h2>
      <p>
        Home connections are slow for uploads, and LightPhotos uploads
        several photos at once. My first version gave each upload a fixed
        five-minute limit. Large photos on a slow connection that eight
        uploads shared hit that limit, although the connection worked. Now
        each upload gets one minute plus extra time based on its size,
        calculated as if a 1&nbsp;Mbit/s connection were split between eight
        uploads:
      </p>
      <pre class="lp-code">time allowed = 60 s
             + photo size / 16 KB per second</pre>

      <figure class="lp-figure lp-try" id="immich-timeout">
        <div class="lp-try-controls">
          <label>Photo size <input type="range" min="1" max="40" step="1" value="25"></label>
        </div>
        <svg viewBox="0 0 640 124" role="img" aria-label="Upload time at 16 KB per second compared with the old five-minute limit and the new limit, for the selected photo size.">
          <text class="lp-fig-label" x="0" y="12">MINUTES, ONE UPLOAD AT 16 KB/S</text>
          <text class="lp-fig-t" x="0" y="40">Upload needs</text>
          <rect class="lp-fig-bar-dim" data-el="need" x="140" y="26" width="276" height="20" rx="2"></rect>
          <text class="lp-fig-t" x="0" y="72">New limit</text>
          <rect class="lp-fig-bar" data-el="new" x="140" y="58" width="287" height="20" rx="2"></rect>
          <line class="lp-fig-bad-stroke" x1="192" y1="20" x2="192" y2="86" stroke-width="2"></line>
          <text class="lp-fig-s" x="198" y="98">old limit: 5 min</text>
          <g class="lp-fig-s">
            <text x="140" y="118" text-anchor="middle">0</text>
            <text x="244" y="118" text-anchor="middle">10</text>
            <text x="348" y="118" text-anchor="middle">20</text>
            <text x="452" y="118" text-anchor="middle">30</text>
            <text x="556" y="118" text-anchor="middle">40</text>
          </g>
        </svg>
        <p class="lp-try-readout" aria-live="polite">25 MB: needs approximately 27 min. Old limit 5 min: fails. New limit: approximately 28 min.</p>
        <figcaption>
          Drag the photo size. The new limit always leaves one minute more
          than the upload needs at 16 KB/s.
        </figcaption>
      </figure>

      <p>
        A connection that is truly stuck still fails, because the other
        limits, to connect and to wait for the server reply, stay short.
      </p>

      <h2>Why it is not in the browser</h2>
      <p>
        A web page can talk to a server on another site only if that server
        gives permission. Immich does not, so the browser blocks the request
        before it sends it.
        The web version shows a note under Immich that it works only
        in the desktop app, which is not a web page.
      </p>

      <h2>What is next</h2>
      <p>
        Next is albums: pick an existing album or type a new name. After
        that, automatic retries for uploads that fail part way. Servers with
        self-signed certificates, common on home networks, probably will not
        connect yet. If you have one, please tell me.
      </p>
      <p>
        Report problems on the <a
        href="https://github.com/andrewyao/lightphotos/issues">issue
        tracker</a>. The desktop builds are on the <a
        href="/downloads.html">downloads page</a>.
      </p>

      <nav class="lp-article-nav" aria-label="More posts">
        <a class="lp-article-nav-prev" href="/blogs/challenges-with-webassembly.html">
          <span class="lp-article-nav-dir">Back</span>
          <span class="lp-article-nav-title">Challenges with WebAssembly</span>
        </a>
        <a class="lp-article-nav-next" href="/blogs/two-rust-photo-apps-in-the-browser.html">
          <span class="lp-article-nav-dir">Next</span>
          <span class="lp-article-nav-title">Two Rust photo apps in the browser</span>
        </a>
      </nav>
    </article>
  </main>
  <script>
    // Connect demo: the three steps from the post. Addresses are the post's own examples.
    const connect = document.getElementById("immich-connect");
    if (connect) {
      const typed = ["photos.example.com", "https://photos.example.com/api/", "http://nas.local:2283"];
      const state = { addr: 0, key: "real", check: "me" };
      const el = (name) => connect.querySelector(`[data-el="${name}"]`);
      const readout = connect.querySelector(".lp-try-readout");
      const clean = (raw) => {
        let a = raw.trim().replace(/\/+$/, "").replace(/\/api$/, "");
        return /^https?:\/\//.test(a) ? a : `https://${a}`;
      };
      const update = () => {
        const raw = typed[state.addr];
        const base = clean(raw);
        for (const [attr, key] of [["data-addr", "addr"], ["data-key", "key"], ["data-check", "check"]]) {
          connect.querySelectorAll(`[${attr}]`).forEach((b) =>
            b.setAttribute("aria-pressed", String(b.getAttribute(attr) === String(state[key]))));
        }
        el("typed").textContent = raw;
        el("clean").textContent = base;
        el("api").textContent = `${base}/api`;
        el("ask").textContent = state.check === "me" ? "GET /users/me" : "about this server";
        const real = state.key === "real";
        const replied = real || state.check === "about";
        let result, cls, dot;
        if (real) {
          result = "Saves the address and the key.";
          cls = "lp-fig-box-accent"; dot = "lp-fig-good";
        } else if (state.check === "me") {
          result = "Saves nothing. You see the error at once.";
          cls = "lp-fig-box"; dot = "lp-fig-bad";
        } else {
          result = "Looks fine. The first upload fails later.";
          cls = "lp-fig-box"; dot = "lp-fig-bad";
        }
        el("reply").textContent = !replied
          ? "“the server rejected the API key”"
          : state.check === "me" ? "“Connected as” your name and email" : "a reply, for every key (Gumnut)";
        el("result").textContent = result;
        el("result-box").setAttribute("class", cls);
        el("result-dot").setAttribute("class", dot);
        readout.textContent = raw.startsWith("http://")
          ? "You typed http://, so LightPhotos uses it. It never switches to HTTP by itself."
          : raw.includes("/api")
            ? "LightPhotos removes the trailing slash and /api, then finds the API again."
            : "No scheme typed, so LightPhotos adds https://.";
      };
      connect.querySelectorAll("[data-addr]").forEach((b) =>
        b.addEventListener("click", () => { state.addr = Number(b.dataset.addr); update(); }));
      connect.querySelectorAll("[data-key]").forEach((b) =>
        b.addEventListener("click", () => { state.key = b.dataset.key; update(); }));
      connect.querySelectorAll("[data-check]").forEach((b) =>
        b.addEventListener("click", () => { state.check = b.dataset.check; update(); }));
    }

    // Timeout demo: time allowed = 60 s + size / 16 KB per second. Old limit: 5 minutes.
    const timeout = document.getElementById("immich-timeout");
    if (timeout) {
      const range = timeout.querySelector("input[type=range]");
      const readout = timeout.querySelector(".lp-try-readout");
      const x0 = 140, pxPerMin = 10.4;
      const update = () => {
        const mb = Number(range.value);
        const needMin = (mb * 1024) / 16 / 60;
        const newMin = needMin + 1;
        timeout.querySelector('[data-el="need"]').setAttribute("width", String(Math.round(needMin * pxPerMin)));
        timeout.querySelector('[data-el="new"]').setAttribute("width", String(Math.round(newMin * pxPerMin)));
        const fmt = (m) => (m < 10 ? m.toFixed(1) : String(Math.round(m)));
        const old = needMin > 5 ? "fails" : "passes";
        readout.textContent = `${mb} MB: needs approximately ${fmt(needMin)} min. Old limit 5 min: ${old}. New limit: approximately ${fmt(newMin)} min.`;
      };
      range.addEventListener("input", update);
    }
  </script>
</Base>
