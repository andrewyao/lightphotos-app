    </article>
  </main>
  <script>
    // Replays one "next photo" step in real time, or shows a jump to a photo
    // neither app prepared.
    const fig = document.getElementById("start-demo");
    if (fig) {
      const el = (name: string) => fig.querySelector(`[data-el="${name}"]`) as SVGElement;
      const readout = fig.querySelector(".lp-try-readout") as HTMLElement;
      const btns = fig.querySelectorAll<HTMLButtonElement>("[data-act]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

      const LP = 0.1; // s, LightPhotos, next photo (median of 8)
      const LC = 0.97; // s, LightCraft, next photo (median of 8)
      const PX_PER_S = 270 / LC;
      let frame = 0;

      const setBar = (name: string, t: number) => el(name).setAttribute("width", String(Math.max(0, t * PX_PER_S)));
      const fmt = (t: number) => `${t.toFixed(2)} s`;

      function draw(t: number) {
        setBar("lc-bar", Math.min(t, LC));
        el("lc-time").textContent = fmt(Math.min(t, LC));
        setBar("lp-bar", Math.min(t, LP));
        el("lp-time").textContent = fmt(Math.min(t, LP));
      }

      function show(act: string) {
        cancelAnimationFrame(frame);
        const jump = act === "jump";
        btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.act === act)));
        el("jpeg").setAttribute("class", jump ? "lp-fig-box-accent" : "lp-fig-box");
        el("from-jpeg").setAttribute("opacity", jump ? "1" : "0");
        el("lp-work").textContent = jump ? "The camera's JPEG at once, then the develop" : "Developed before you press the key";
        if (jump) {
          setBar("lp-bar", 0);
          setBar("lc-bar", 0);
          el("lp-time").textContent = "not timed";
          el("lc-time").textContent = "not timed";
          readout.textContent = "Jump in the grid: neither app has the photo ready. LightPhotos shows the camera's JPEG at once, then develops the RAW data at the window's size. LightCraft develops the RAW data. I did not time this case.";
          return;
        }
        const summary = "Next photo: LightPhotos shows it in 0.10 s, because it developed it in advance. LightCraft takes 0.97 s.";
        if (reduce.matches) {
          draw(LC);
          readout.textContent = summary;
          return;
        }
        readout.textContent = "Next photo…";
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.max(0, now - start) / 1000;
          draw(t);
          if (t < LC) frame = requestAnimationFrame(tick);
          else readout.textContent = summary;
        };
        frame = requestAnimationFrame(tick);
      }

      btns.forEach((b) => b.addEventListener("click", () => show(b.dataset.act!)));
    }
  </script>
  <script>
    // Shows where each app keeps the photos, and what one action does to each.
    type Line = { ok: boolean; a: string; b: string };
    type Step = { lp: Line; lc: Line; copied: boolean; say: string };

    // Each line restates a fact from the post.
    const STEPS: Record<string, Step> = {
      open: {
        lp: { ok: true, a: "Reads the folder in place. 0 MB copied.", b: "The browser asks once for access to it." },
        lc: { ok: true, a: "Copies all 498 MB into browser storage.", b: "The copy is part of its 2.5 s to fill the grid." },
        copied: true,
        say: "LightPhotos reads the photos where they are. LightCraft copies 498 MB first.",
      },
      reload: {
        lp: { ok: false, a: "Asks for access to the folder again,", b: "unless you allowed it on every visit." },
        lc: { ok: true, a: "The library is still there.", b: "No prompt." },
        copied: true,
        say: "After a reload, LightCraft's library is waiting. LightPhotos must ask for the folder.",
      },
      clear: {
        lp: { ok: true, a: "Nothing lost. Ratings and edits are in", b: ".lightphotos, on your disk." },
        lc: { ok: false, a: "The library and its copies are gone.", b: "Edits you did not export are lost." },
        copied: false,
        say: "Clearing the site's data empties browser storage. Your disk is not touched.",
      },
      other: {
        lp: { ok: false, a: "No folder access in these browsers,", b: "so it cannot open the folder." },
        lc: { ok: true, a: "Works. It needs only the file dialog", b: "and browser storage." },
        copied: true,
        say: "LightPhotos needs Chrome or Edge. LightCraft runs in every modern browser.",
      },
    };

    const fig = document.getElementById("import-demo");
    if (fig) {
      const el = (name: string) => fig.querySelector(`[data-el="${name}"]`) as SVGElement;
      const show = (name: string, on: boolean) => el(name).setAttribute("display", on ? "inline" : "none");
      const readout = fig.querySelector(".lp-try-readout") as HTMLElement;
      const btns = fig.querySelectorAll<HTMLButtonElement>("[data-act]");

      const line = (key: string, l: Line) => {
        show(`${key}-ok`, l.ok);
        show(`${key}-bad`, !l.ok);
        el(`${key}-1`).textContent = l.a;
        el(`${key}-2`).textContent = l.b;
      };

      const render = (act: string) => {
        const s = STEPS[act];
        btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.act === act)));
        el("side").setAttribute("opacity", act === "other" ? "0.3" : "1");
        el("copy").setAttribute("opacity", s.copied ? "1" : "0");
        el("bar").setAttribute("width", s.copied ? "272" : "0");
        el("size").textContent = s.copied ? "Originals by content hash: 498 MB" : "Empty. Cleared with the site's data.";
        show("opfs-x", !s.copied);
        line("lp", s.lp);
        line("lc", s.lc);
        readout.textContent = s.say;
      };

      btns.forEach((b) => b.addEventListener("click", () => render(b.dataset.act!)));
    }
  </script>
</Base>
