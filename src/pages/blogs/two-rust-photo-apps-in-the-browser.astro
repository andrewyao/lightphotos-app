          <text class="lp-fig-s" x="20" y="187">Preview or camera JPEG</text>
          <rect class="lp-fig-bar" x="170" y="178" width="14" height="10"></rect>
          <text class="lp-fig-s" x="190" y="187">Sharp photo</text>
