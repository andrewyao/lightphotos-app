          <rect class="lp-fig-box-accent" x="250" y="34" width="390" height="76" rx="6"></rect>
          <text class="lp-fig-t" x="266" y="58">LightPhotos</text>
          <text class="lp-fig-s" data-el="lp-work" x="266" y="78">Developed before you press the key</text>
