  </main>
  <script>
    // Replays one key press in real time: what each app has on screen, and
    // when the whole screen stops changing.
    type Row = { first: number; sharp: number; settled: number };
    type Mode = { lp: Row; lc: Row; scale: number; say: string };

    // Medians from the full-screen runs, in seconds. scale is the right end of the axis.
    const MODES: Record<string, Mode> = {
      next: {
        lp: { first: 0.07, sharp: 0.07, settled: 0.13 },
        lc: { first: 0.05, sharp: 0.12, settled: 1.7 },
        scale: 2,
        say: "Next photo: both apps show the sharp photo almost at once. LightCraft's histogram changes until 1.70 s.",
      },
      open: {
        lp: { first: 0.15, sharp: 1.37, settled: 1.37 },
        lc: { first: 0.06, sharp: 3.6, settled: 3.6 },
        scale: 4,
        say: "Open from the grid: LightPhotos shows the camera's JPEG at 0.15 s and the sharp photo at 1.37 s. LightCraft shows a preview at 0.06 s and the sharp photo at 3.6 s.",
      },
    };

    const fig = document.getElementById("start-demo");
    if (fig) {
      const el = (name: string) => fig.querySelector(`[data-el="${name}"]`) as SVGElement;
      const readout = fig.querySelector(".lp-try-readout") as HTMLElement;
      const btns = fig.querySelectorAll<HTMLButtonElement>("[data-act]");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
      const fmt = (t: number) => `${t.toFixed(2)} s`;
      let frame = 0;

      function drawRow(key: string, r: Row, scale: number, t: number) {
        const px = 380 / scale;
        const x = (s: number) => String(120 + s * px);
        el(`${key}-pre`).setAttribute("x", x(r.first));
        el(`${key}-pre`).setAttribute("width", String(Math.max(0, Math.min(t, r.sharp) - r.first) * px));
        el(`${key}-sharp`).setAttribute("x", x(r.sharp));
        el(`${key}-sharp`).setAttribute("width", String(Math.max(0, t - r.sharp) * px));
        const y = key === "lp" ? 36 : 92;
        el(`${key}-mark`).setAttribute("d", `M${x(r.settled)} ${y} V${y + 32}`);
        el(`${key}-mark`).setAttribute("opacity", t >= r.settled ? "1" : "0");
        el(`${key}-sharp-t`).textContent = t >= r.sharp ? `Sharp ${fmt(r.sharp)}` : `Sharp …`;
        el(`${key}-mark-t`).textContent = t >= r.settled ? `Settled ${fmt(r.settled)}` : `Settled …`;
      }

      function show(act: string) {
        cancelAnimationFrame(frame);
        const m = MODES[act];
        btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.act === act)));
        for (let i = 1; i <= 4; i++) {
          const v = ((m.scale * i) / 4).toFixed(1);
          el(`tick${i}`).textContent = i === 4 ? `${v} s` : v;
        }
        const draw = (t: number) => {
          drawRow("lp", m.lp, m.scale, t);
          drawRow("lc", m.lc, m.scale, t);
        };
        if (reduce.matches) {
          draw(m.scale);
          readout.textContent = m.say;
          return;
        }
        readout.textContent = "…";
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min(m.scale, Math.max(0, now - start) / 1000);
          draw(t);
          if (t < m.scale) frame = requestAnimationFrame(tick);
          else readout.textContent = m.say;
        };
        frame = requestAnimationFrame(tick);
      }

      btns.forEach((b) => b.addEventListener("click", () => show(b.dataset.act!)));
    }
  </script>
  <script>
    // Shows where each app keeps the photos, and what one action does to each.
    type Line = { ok: boolean; a: string; b: string };
    type Step = { lp: Line; lc: Line; copied: boolean; say: string };

    // Each line restates a fact from the post.
    const STEPS: Record<string, Step> = {
      open: {
        lp: { ok: true, a: "Reads the folder in place. 0 MB copied.", b: "The browser asks once for access to it." },
        lc: { ok: true, a: "Copies all 498 MB into browser storage.", b: "The copy is part of its 2.3 s to fill the grid." },
        copied: true,
        say: "LightPhotos reads the photos where they are. LightCraft copies 498 MB first.",
      },
      reload: {
        lp: { ok: false, a: "Asks for access to the folder again,", b: "unless you allowed it on every visit." },
        lc: { ok: true, a: "The library is still there.", b: "No prompt." },
        copied: true,
        say: "After a reload, LightCraft's library is waiting. LightPhotos must ask for the folder.",
      },
      clear: {
        lp: { ok: true, a: "Nothing lost. Ratings and edits are in", b: ".lightphotos, on your disk." },
        lc: { ok: false, a: "The library and its copies are gone.", b: "Edits you did not export are lost." },
        copied: false,
        say: "Clearing the site's data empties browser storage. Your disk is not touched.",
      },
      other: {
        lp: { ok: false, a: "No folder access in these browsers,", b: "so it cannot open the folder." },
        lc: { ok: true, a: "Works. It needs only the file dialog", b: "and browser storage." },
        copied: true,
        say: "LightPhotos needs Chrome or Edge. LightCraft runs in every modern browser.",
      },
    };

    const fig = document.getElementById("import-demo");
    if (fig) {
      const el = (name: string) => fig.querySelector(`[data-el="${name}"]`) as SVGElement;
      const show = (name: string, on: boolean) => el(name).setAttribute("display", on ? "inline" : "none");
      const readout = fig.querySelector(".lp-try-readout") as HTMLElement;
      const btns = fig.querySelectorAll<HTMLButtonElement>("[data-act]");

      const line = (key: string, l: Line) => {
        show(`${key}-ok`, l.ok);
        show(`${key}-bad`, !l.ok);
        el(`${key}-1`).textContent = l.a;
        el(`${key}-2`).textContent = l.b;
      };

      const render = (act: string) => {
        const s = STEPS[act];
        btns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.act === act)));
        el("side").setAttribute("opacity", act === "other" ? "0.3" : "1");
        el("copy").setAttribute("opacity", s.copied ? "1" : "0");
        el("bar").setAttribute("width", s.copied ? "272" : "0");
        el("size").textContent = s.copied ? "Originals by content hash: 498 MB" : "Empty. Cleared with the site's data.";
        show("opfs-x", !s.copied);
        line("lp", s.lp);
        line("lc", s.lc);
        readout.textContent = s.say;
      };

      btns.forEach((b) => b.addEventListener("click", () => render(b.dataset.act!)));
    }
  </script>
</Base>
