          <rect class="lp-fig-box" x="595" y="180" width="17" height="13" rx="2"></rect>
          <rect class="lp-fig-box" x="616" y="180" width="17" height="13" rx="2"></rect>
          <text class="lp-fig-t" x="498" y="216" text-anchor="middle">visible rows, plus a cushion</text>
          <text class="lp-fig-s" x="498" y="234" text-anchor="middle">110 to 150 MB, whatever the folder holds</text>
