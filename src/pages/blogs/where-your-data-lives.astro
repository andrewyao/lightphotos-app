---
import Base from "../../layouts/Base.astro";
---
<Base
  title="Your data lives where you can write — LightPhotos Blog"
  desc="Why LightPhotos keeps ratings, edits and thumbnails in a folder next to your photos instead of in a database, and how the permission rules of a browser made that decision for me."
  active="blogs"
>
  <main class="lp-page">
    <article class="lp-article">
      <header class="lp-article-head">
        <p class="lp-article-meta"><a href="/blogs.html">Blogs</a> &middot; <time datetime="2026-08-10">August 10, 2026</time></p>
        <h1>Your data lives where you are allowed to write</h1>
        <p class="lp-article-dek">
          Why ratings, edits and thumbnails sit in a folder next to your photos
          instead of in a database, and how the permission rules of a browser
          made that decision for me.
        </p>
        <p class="lp-article-byline">Andrew Yao &middot; 5 min read</p>
      </header>

      <aside class="lp-tldr">
        <p class="lp-tldr-label">TL;DR</p>
        <p>
          A central catalog keyed by full path lost track of your ratings when
          you moved a folder. So I save them in a hidden folder next to your
          photos. The browser version
          can write only inside the folder you picked, so the thumbnail cache
          moved there too. The costs: a search across every folder is slow,
          and a renamed photo loses track of its ratings and edits until I
          build a fix.
        </p>
      </aside>

      <figure class="lp-figure lp-try" id="dl-demo">
        <div class="lp-try-controls">
          <span role="group" aria-label="Where the app keeps data" class="lp-try-controls" style="margin:0">
            Keep data in
            <button type="button" class="lp-try-btn" data-group="store" data-value="catalog" aria-pressed="false">Central catalog</button>
            <button type="button" class="lp-try-btn" data-group="store" data-value="sidecar" aria-pressed="true">Next to the photos</button>
          </span>
          <span role="group" aria-label="What you do next" class="lp-try-controls" style="margin:0">
            Then
            <button type="button" class="lp-try-btn" data-group="act" data-value="none" aria-pressed="false">Nothing</button>
            <button type="button" class="lp-try-btn" data-group="act" data-value="move" aria-pressed="true">Move the folder</button>
            <button type="button" class="lp-try-btn" data-group="act" data-value="rename" aria-pressed="false">Rename a photo</button>
            <button type="button" class="lp-try-btn" data-group="act" data-value="browser" aria-pressed="false">Open in a browser</button>
          </span>
        </div>
        <svg viewBox="0 0 640 250" role="img" aria-label="Where LightPhotos keeps ratings, edits and thumbnails for the selected design, and what happens to them after the selected action.">
          <text class="lp-fig-label" x="0" y="12">WHERE THE DATA IS</text>

          <rect class="lp-fig-box" x="0" y="24" width="320" height="62" rx="8" data-lib-box></rect>
          <text class="lp-fig-mono lp-fig-t" x="14" y="46">~/Library/</text>
          <text class="lp-fig-s" x="14" y="66" data-lib-1>Nothing from LightPhotos.</text>
          <text class="lp-fig-s" x="14" y="80" data-lib-2></text>
          <path class="lp-fig-bad-stroke" d="M284 38 L304 58 M304 38 L284 58" data-lib-x display="none"></path>

          <path class="lp-fig-line" d="M60 86 V118" data-cat-link display="none"></path>
          <path class="lp-fig-bad-stroke" d="M52 94 L68 110 M68 94 L52 110" data-cat-x display="none"></path>

          <rect class="lp-fig-line" x="-0" y="112" width="320" height="134" rx="10" stroke-dasharray="4 4" data-sandbox display="none"></rect>
          <rect class="lp-fig-panel" x="4" y="118" width="312" height="124" rx="8"></rect>
          <text class="lp-fig-mono lp-fig-t" x="18" y="140" data-path>/Volumes/Drive/Iceland/</text>
          <text class="lp-fig-mono lp-fig-s" x="34" y="162" data-photo>IMG_4471.jpg</text>
          <g data-side>
            <text class="lp-fig-mono lp-fig-s" x="34" y="184">.lightphotos/</text>
            <rect class="lp-fig-box-accent" x="46" y="192" width="258" height="40" rx="5"></rect>
            <text class="lp-fig-mono lp-fig-s" x="56" y="208">IMG_4471.jpg.xmp</text>
            <text class="lp-fig-s" x="56" y="224">ratings, edits, one thumbnail per photo</text>
          </g>

          <text class="lp-fig-label" x="350" y="12">RESULT</text>
          <text class="lp-fig-t" x="350" y="44">Ratings and edits</text>
          <circle class="lp-fig-good" cx="356" cy="62" r="4" data-r-ok></circle>
          <path class="lp-fig-bad-stroke" d="M352 58 L360 66 M360 58 L352 66" data-r-bad display="none"></path>
          <text class="lp-fig-s" x="368" y="66" data-r-1>They move with the folder.</text>
          <text class="lp-fig-s" x="368" y="84" data-r-2>The app needs no extra code.</text>

          <g data-t-row>
            <text class="lp-fig-t" x="350" y="130">Thumbnails</text>
            <circle class="lp-fig-good" cx="356" cy="148" r="4" data-t-ok></circle>
            <path class="lp-fig-bad-stroke" d="M352 144 L360 152 M360 144 L352 152" data-t-bad display="none"></path>
            <text class="lp-fig-s" x="368" y="152" data-t-1>They move too. On another computer,</text>
            <text class="lp-fig-s" x="368" y="170" data-t-2>the grid fills instantly.</text>
          </g>
        </svg>
        <p class="lp-try-readout" aria-live="polite">You moved the folder to an external drive. Your work went with it.</p>
        <figcaption>
          Pick where the app keeps your data. Then pick what you do with the
          folder.
        </figcaption>
      </figure>

      <p>
        LightPhotos has no database. When you give a photo four stars, the app
        writes a small JSON file called <code>IMG_4471.jpg.xmp</code> into a
        hidden <code>.lightphotos</code> folder, next to
        <code>IMG_4471.jpg</code>. That is the whole system for saving your work. Two problems pushed me
        into this design.
      </p>

      <h2>My first attempt</h2>
      <p>
        I started with one catalog for the whole app, in the usual folder where
        Mac apps keep their data. It recorded each photo by its full
        path on disk. This fails in exactly the way people use a photo tool,
        because people move folders. You import a card into <code>~/Desktop/import</code> and
        cull for an hour. Then you drag the folder to an external drive, and
        every path in the catalog points to nothing.
      </p>

      <h2>Putting it next to the photos</h2>
      <p>
        Now your ratings and edits move when you move the folder, copy it to a
        friend or back it up. I did not write any code for that. Some
        details:
      </p>
      <ul class="lp-article-list">
        <li>
          <strong>The app makes the folder only when you save something.</strong>
          If you only look through someone else's photos, the app leaves
          nothing behind.
        </li>
        <li>
          <strong>The app writes each file to a temporary copy, then renames
          it.</strong> On all common disk formats, a rename is atomic: it
          happens in one step. So if the app crashes partway through, you keep
          the previous version, not a half-written file.
        </li>
        <li>
          <strong>The app never changes your original photo.</strong> This app
          is for deciding which photos to keep. So it must not change them.
        </li>
      </ul>

      <h2>Then the browser made the decision for me</h2>
      <p>
        Thumbnails take time to make, so the app saves them to disk. On the
        Mac, that cache lived in <code>~/Library/Caches</code>, where Apple
        tells you to put it. Then I made the app run in a browser tab. A tab can
        read and write only inside the folder you picked. With the cache
        anywhere else, the browser version would rebuild every thumbnail each
        time you opened the page.
      </p>
      <p>
        So I moved the thumbnail cache into <code>.lightphotos</code>. The old
        cache worked and nobody complained, so I would never have found
        this design on my own. But the result was better on the Mac too.
        When you plug the drive into another computer, the grid fills
        instantly. The app does not spend a minute rebuilding every thumbnail.
        The lesson: design for the strictest platform early.
      </p>
      <p>
        The Mac and browser versions share one cache, and that needed one
        deliberate compromise. The app recognises a cached thumbnail by the file size of
        the photo and the time it was last changed. A browser gives that time
        only to the millisecond, and the Mac gives it to the nanosecond. So
        the app rounds to the millisecond. Without the rounding, the two
        versions would label the same untouched photo differently and never
        find each other's thumbnails.
      </p>
      <p>
        There is one cached thumbnail per photo. So the cache of a folder can
        never have more entries than the folder has photos, and I need no
        eviction rules. When a folder
        opens, I only remove leftovers for deleted photos. If the app cannot
        write to a folder, it makes fresh thumbnails every time and does not
        bother you about it. It is a little slower there, and I decided that
        was not worth an error message.
      </p>

      <h2>What it cost me</h2>
      <p>
        The app keys everything by the filename of the photo alone, because
        the location of the file already gives the folder. This makes work
        across folders risky. If you switch folders while a background job
        runs, a late result could be saved against a photo with the same name
        in the new folder. I wrote that warning on the code that handles
        those results. You can change folders at any time. This is what happens
        to each job:
      </p>
      <ul class="lp-article-list">
        <li>
          <strong>Exports keep running.</strong> Each export knows the full
          location of the photo and its edits, so it finishes no matter which
          folder is open.
        </li>
        <li>
          <strong>The app saves your current edits first.</strong> If you moved
          a slider and did not leave the photo yet, I save that change before
          the new folder opens.
        </li>
        <li>
          <strong>Thumbnails keep running, and the app drops late
          results.</strong> If a result for the old folder finishes after you
          leave it, the app drops it, so it cannot land on a photo with the
          same name.
        </li>
        <li>
          <strong>Auto Tone stops.</strong> Photos that it already finished
          keep their changes. The app skips the rest.
        </li>
        <li>
          <strong>Bulk delete stops.</strong> It finishes the photo that it is
          moving to the trash at that moment, then stops.
        </li>
      </ul>
      <p>
        I plan to fix those last two. Each job would carry the full location of
        its photo, as exports do, so the open folder would no longer matter
        when the job finishes. Then you would not wait for Auto Tone on a big
        shoot before you look at another folder.
      </p>
      <p>
        There is also no quick search across every folder you ever opened. "Show
        me everything I rated five stars this year" means a visit to
        each folder. A central database could answer that in a millisecond.
        If that kind of search was central to LightPhotos, this would be the
        wrong design.
      </p>
      <p>
        The cost that worries me most is renaming. The sidecar file finds its
        photo only by filename. Rename <code>IMG_4471.jpg</code> to
        <code>iceland-sunset.jpg</code> in Finder, and the sidecar is still
        <code>IMG_4471.jpg.xmp</code>. LightPhotos no longer knows that the two
        files belong together, so your rating and edits seem to disappear.
        Renaming is normal, so this design is fragile.
      </p>
      <p>
        I have not fixed this yet, but I know how. Each sidecar would also
        store a fingerprint (a hash) that the app calculates from the contents
        of the photo. When a folder has sidecars that match no photo, the app
        would calculate the fingerprints of the photos in that folder. If one
        matches, the photo was only renamed, so the app renames the sidecar to
        match its new name, and your ratings and edits come back.
      </p>

      <nav class="lp-article-nav" aria-label="More posts">
        <a class="lp-article-nav-prev" href="/blogs/what-imageio-gives-you-free.html">
          <span class="lp-article-nav-dir">Back</span>
          <span class="lp-article-nav-title">What ImageIO gives you free, and what it costs to leave</span>
        </a>
        <a class="lp-article-nav-next" href="/blogs/six-queues-and-a-reserved-worker.html">
          <span class="lp-article-nav-dir">Next</span>
          <span class="lp-article-nav-title">Six queues and a reserved worker</span>
        </a>
      </nav>
    </article>
  </main>
  <script>
    type Result = { ok: boolean; a: string; b: string };
    type Row = { r: Result; t: Result | null; say: string };

    // Each line restates a fact from the post. t is null where the post makes no claim.
    const RESULTS: Record<string, Record<string, Row>> = {
      catalog: {
        none: {
          r: { ok: true, a: "Found by the full path", b: "in catalog.db." },
          t: { ok: true, a: "Cached in ~/Library/Caches.", b: "" },
          say: "One central catalog. It works while nothing moves.",
        },
        move: {
          r: { ok: false, a: "Every path in the catalog", b: "points to nothing." },
          t: { ok: false, a: "Left in ~/Library. Another computer", b: "must rebuild every thumbnail." },
          say: "You moved the folder to an external drive. An hour of culling is lost.",
        },
        rename: {
          r: { ok: false, a: "The full path changed, so the", b: "catalog no longer finds them." },
          t: null,
          say: "The catalog keys each photo by its full path.",
        },
        browser: {
          r: { ok: false, a: "A browser tab cannot", b: "reach ~/Library." },
          t: { ok: false, a: "Rebuilt each time you", b: "open the page." },
          say: "A browser tab can read and write only inside the folder you picked.",
        },
      },
      sidecar: {
        none: {
          r: { ok: true, a: "In .lightphotos, next to", b: "the photo." },
          t: { ok: true, a: "In .lightphotos, one per photo.", b: "" },
          say: "No central database. The app never changes the photo.",
        },
        move: {
          r: { ok: true, a: "They move with the folder.", b: "The app needs no extra code." },
          t: { ok: true, a: "They move too. On another computer,", b: "the grid fills instantly." },
          say: "You moved the folder to an external drive. Your work went with it.",
        },
        rename: {
          r: { ok: false, a: "The sidecar is still IMG_4471.jpg.xmp.", b: "Your ratings and edits seem lost." },
          t: null,
          say: "Not fixed yet. My plan: store a fingerprint of the photo in each sidecar.",
        },
        browser: {
          r: { ok: true, a: "The tab can write inside", b: "the folder you picked." },
          t: { ok: true, a: "The Mac and browser versions", b: "share one cache." },
          say: "The browser allows exactly this folder, and the data is already in it.",
        },
      },
    };

    const fig = document.getElementById("dl-demo");
    if (fig) {
      const $ = (sel: string) => fig.querySelector(sel)!;
      const show = (sel: string, on: boolean) => $(sel).setAttribute("display", on ? "inline" : "none");
      const state: Record<string, string> = { store: "sidecar", act: "move" };

      const render = () => {
        const { store, act } = state;
        const catalog = store === "catalog";
        const row = RESULTS[store][act];

        $("[data-lib-box]").setAttribute("class", catalog ? "lp-fig-box-accent" : "lp-fig-box");
        $("[data-lib-1]").textContent = catalog ? "catalog.db: ratings and edits by full path" : "Nothing from LightPhotos.";
        $("[data-lib-2]").textContent = catalog ? "Caches/: thumbnails" : "";
        show("[data-lib-x]", act === "browser");
        show("[data-cat-link]", catalog);
        show("[data-cat-x]", catalog && (act === "move" || act === "rename" || act === "browser"));
        show("[data-sandbox]", act === "browser");
        show("[data-side]", !catalog);
        $("[data-path]").textContent = act === "move" ? "/Volumes/Drive/Iceland/" : "~/Desktop/import/Iceland/";
        $("[data-photo]").textContent = act === "rename" ? "iceland-sunset.jpg" : "IMG_4471.jpg";

        const line = (key: string, res: Result) => {
          show(`[data-${key}-ok]`, res.ok);
          show(`[data-${key}-bad]`, !res.ok);
          $(`[data-${key}-1]`).textContent = res.a;
          $(`[data-${key}-2]`).textContent = res.b;
        };
        line("r", row.r);
        show("[data-t-row]", row.t !== null);
        if (row.t) line("t", row.t);
        $(".lp-try-readout").textContent = row.say;
      };

      const buttons = fig.querySelectorAll<HTMLButtonElement>("[data-group]");
      buttons.forEach((btn) =>
        btn.addEventListener("click", () => {
          const group = btn.dataset.group!;
          state[group] = btn.dataset.value!;
          buttons.forEach((b) => {
            if (b.dataset.group === group) b.setAttribute("aria-pressed", String(b === btn));
          });
          render();
        }),
      );
    }
  </script>
</Base>
