---
import Base from "../../../layouts/Base.astro";
import { languagePaths, type LanguageProps } from "../../../i18n/routes";
import WebAppLink from "../../../components/WebAppLink.astro";

// Post aimed at people searching for a Lightroom alternative. The
// "What LightPhotos does not do yet" section is the point: overclaiming here
// would cost more trust than the page earns. Keep it in step with docs/adjust,
// docs/export and docs/shortcuts when features land.

export const getStaticPaths = languagePaths;
const { lang } = Astro.props as LanguageProps;
---
<Base
  title="A free, open-source Lightroom alternative — LightPhotos Blog"
  desc="LightPhotos compared with Adobe Lightroom: no subscription, no account, no cloud, a download under 30MB, and Linux support. Plus an honest list of what it does not do yet."
  active="blogs"
  lang={lang}
  path="/blogs/lightroom-alternative.html"
  translated={false}
>
  <main class="lp-page">
    <article class="lp-article">
      <header class="lp-article-head">
        <p class="lp-article-meta"><a href="/blogs.html">Blogs</a> &middot; <time datetime="2026-10-08">October 8, 2026</time></p>
        <h1>A free, open-source alternative to Lightroom</h1>
        <p class="lp-article-dek">
          LightPhotos is for photographers who want to get through a shoot fast,
          make good edits, and export, without a subscription or a cloud
          account. It is not a full Lightroom replacement yet.
        </p>
        <p class="lp-article-byline">Andrew Yao &middot; 3 min read</p>
      </header>

      <h2>Side by side</h2>
      <div class="lp-compare-wrap">
        <table class="lp-compare">
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col" class="lp-compare-pick" style="width: 33%;">LightPhotos</th>
              <th scope="col" style="width: 33%;">Adobe Lightroom</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Price</th>
              <td class="lp-compare-pick">Free</td>
              <td>Paid subscription</td>
            </tr>
            <tr>
              <th scope="row">Account</th>
              <td class="lp-compare-pick">None</td>
              <td>Adobe account required</td>
            </tr>
            <tr>
              <th scope="row">Where photos live</th>
              <td class="lp-compare-pick">Your own folders. Nothing is uploaded.</td>
              <td>A catalog (Classic) or Adobe&rsquo;s cloud</td>
            </tr>
            <tr>
              <th scope="row">Source code</th>
              <td class="lp-compare-pick"><a href="https://github.com/andrewyao/lightphotos">Open source</a></td>
              <td>Closed</td>
            </tr>
            <tr>
              <th scope="row">Download size</th>
              <td class="lp-compare-pick">Under 12MB on macOS, under 30MB on Windows and Linux</td>
              <td>Gigabytes</td>
            </tr>
            <tr>
              <th scope="row">Platforms</th>
              <td class="lp-compare-pick">macOS, Windows, Linux, and Chrome with no install</td>
              <td>macOS, Windows, iOS, Android, web. No Linux app.</td>
            </tr>
            <tr>
              <th scope="row">Culling</th>
              <td class="lp-compare-pick">Stars, flags, colour labels, stacks</td>
              <td>Stars, flags, colour labels, stacks</td>
            </tr>
            <tr>
              <th scope="row">Global edits</th>
              <td class="lp-compare-pick">Exposure, contrast, highlights, shadows, whites, blacks, white balance, texture, clarity, dehaze, vibrance, saturation, a colour mixer, colour grading, sharpening, denoise, vignette, grain, black &amp; white, Auto Adjust, and a point tone curve</td>
              <td>All of these, plus camera profiles, a parametric curve, point colour and calibration</td>
            </tr>
            <tr>
              <th scope="row">Presets</th>
              <td class="lp-compare-pick">Your own presets, plus Lightroom <code>.xmp</code> presets imported or read from their folders</td>
              <td>Presets, profiles and premium presets</td>
            </tr>
            <tr>
              <th scope="row">Crop and rotate</th>
              <td class="lp-compare-pick">Crop to an aspect ratio, straighten up to 45&deg; or by drawing a level line, rotate in 90&deg; steps</td>
              <td>All of these, plus Upright perspective correction</td>
            </tr>
            <tr>
              <th scope="row">Lens corrections</th>
              <td class="lp-compare-pick">Chromatic aberration. Lens distortion correction coming soon.</td>
              <td>Lens profiles for distortion and vignetting, chromatic aberration, defringe</td>
            </tr>
            <tr>
              <th scope="row">Masks and local edits</th>
              <td class="lp-compare-pick">Linear and radial gradients, subject and sky masks, spot removal</td>
              <td>All of these, plus brushes, range masks and more AI selections</td>
            </tr>
            <tr>
              <th scope="row">Export</th>
              <td class="lp-compare-pick">Various formats at the size you choose, or straight to Immich</td>
              <td>JPEG, TIFF, PNG, DNG and more, plus print and web publishing</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Where LightPhotos wins</h2>
      <ul class="lp-article-list">
        <li><strong>Lightweight and fast.</strong> Opens instantly, with GPU-accelerated previews and no import step. Folder browsing is smooth and immediate.</li>
        <li><strong>No accounts, no registration, fully local.</strong> There’s nothing to sign up for. Your photos and edits stay on your computer unless you export them to your own Immich server.</li>
        <li><strong>Free to use.</strong> Download and go, or use the <a href="/app.html">web app</a> in Chrome. No cost, no nags, no subscriptions.</li>
        <li><strong>Streamlined culling and rating.</strong> Use number keys and arrow keys for fast selection. Instantly compare frames in a burst to pick the best shot. See <a href="/docs/compare-a-stack.html">Compare a stack</a>.</li>
        <li><strong>Your Lightroom presets.</strong> Point LightPhotos at a folder of Lightroom <code>.xmp</code> presets and apply them in one click, with no copying. See <a href="/docs/presets.html">Presets</a>.</li>
        <li><strong>Quick edits for every photo.</strong> <strong>Auto Adjust</strong> analyzes each photo’s histogram, and <strong>Black &amp; White</strong> or color toggles are one-click for batches or singles.</li>
        <li><strong>Native Linux support.</strong> Runs on macOS, Windows and Linux, on ARM and x86. See <a href="/blogs/linux-raw-photo-editor.html">LightPhotos on Linux</a>.</li>
      </ul>

      <h2>What LightPhotos does not do yet</h2>
      <ul class="lp-article-list">
        <li>No brushes or range masks. Masks are linear and radial gradients, plus subject and sky, with nine sliders each. Subject masks only work in the Mac app.</li>
        <li>The tone curve is a point curve only, with no parametric sliders.</li>
        <li>Chromatic aberration is the only lens correction. No lens profiles, distortion or vignetting correction, and no perspective correction.</li>
        <li>No keywords, collections, maps, face recognition or print module.</li>
        <li>Some cameras are limited outside macOS. See <a href="/docs/formats.html">tested cameras</a>.</li>
      </ul>

      <h2>Try it</h2>
      <p>
        <a href="/downloads.html">Download LightPhotos</a> for macOS, Windows or
        Linux.
        <WebAppLink>
          Or <a href="/app.html">open the web app</a>.
          <span slot="fallback">The web app is not available in your current
          browser. Use Chrome instead.</span>
        </WebAppLink>
        The
        <a href="/docs.html">help pages</a> walk through a whole shoot in five
        short steps.
      </p>

      <p class="lp-trademark">
        Adobe and Lightroom are trademarks of Adobe Inc. LightPhotos is not
        affiliated with or endorsed by Adobe.
      </p>

      <nav class="lp-article-nav" aria-label="More posts">
        <a class="lp-article-nav-prev" href="/blogs/linux-raw-photo-editor.html">
          <span class="lp-article-nav-dir">Back</span>
          <span class="lp-article-nav-title">A fast RAW photo editor for Linux</span>
        </a>
        <a class="lp-article-nav-next" href="/blogs/catalogs.html">
          <span class="lp-article-nav-dir">Next</span>
          <span class="lp-article-nav-title">Catalogs, a first version</span>
        </a>
      </nav>
    </article>
  </main>
</Base>
