            <text class="lp-fig-mono lp-fig-s" x="116" y="78">photo 2</text>
            <text class="lp-fig-mono lp-fig-s" x="212" y="78">photo 3</text>
            <text class="lp-fig-mono lp-fig-s" x="20" y="164">photo 4</text>
            <text class="lp-fig-mono lp-fig-s" x="116" y="164">photo 5</text>
            <text class="lp-fig-mono lp-fig-s" x="212" y="164">photo 6</text>
          </g>

          <path class="lp-fig-line" d="M300 96 H330"></path>
          <path class="lp-fig-arrow" d="M330 91 L330 101 L338 96 Z"></path>

          <text class="lp-fig-label" x="344" y="12">WHAT IT GETS</text>
          <rect class="lp-fig-panel" x="344" y="24" width="296" height="128" rx="8"></rect>
          <g data-view="sr">
            <text class="lp-fig-mono lp-fig-t" x="358" y="50">window "LightPhotos"</text>
            <text class="lp-fig-mono lp-fig-s" x="374" y="72">image, no name</text>
            <text class="lp-fig-s" x="358" y="104">The reader asks for controls.</text>
            <text class="lp-fig-s" x="358" y="122">egui gives pixels only.</text>
          </g>
          <g data-view="shot" display="none">
            <text class="lp-fig-mono lp-fig-t" x="358" y="50">screenshot.png</text>
            <text class="lp-fig-mono lp-fig-s" x="374" y="72">1440 × 900 px</text>
            <text class="lp-fig-s" x="358" y="104">The agent looks at the pixels.</text>
            <text class="lp-fig-s" x="358" y="122">Photo 3 has 3 stars, or 4?</text>
          </g>
          <g data-view="mcp" display="none">
            <text class="lp-fig-mono lp-fig-t" x="358" y="50">list_photos</text>
            <text class="lp-fig-mono lp-fig-s" x="374" y="72">&#123;"photo": 3, "rating": 3, …&#125;</text>
            <text class="lp-fig-mono lp-fig-t" x="358" y="100">run_command</text>
            <text class="lp-fig-mono lp-fig-s" x="374" y="122">photo.rate &#123;"stars": 3&#125;</text>
          </g>

          <text class="lp-fig-label" x="344" y="176">CAN IT RATE PHOTO 3?</text>
          <rect class="lp-fig-panel" x="344" y="188" width="296" height="44" rx="8"></rect>
          <g data-view="sr">
            <circle class="lp-fig-bad" cx="364" cy="210" r="6"></circle>
            <text class="lp-fig-t" x="380" y="215">No. It cannot find photo 3.</text>
          </g>
          <g data-view="shot" display="none">
            <circle class="lp-fig-bad-stroke" cx="364" cy="210" r="6"></circle>
            <text class="lp-fig-t" x="380" y="215">Maybe. It clicks and hopes.</text>
          </g>
          <g data-view="mcp" display="none">
            <circle class="lp-fig-good" cx="364" cy="210" r="6"></circle>
            <text class="lp-fig-t" x="380" y="215">Yes. The reply is "ok": true.</text>
          </g>
        </svg>
        <p class="lp-try-readout" aria-live="polite">The screen reader asks the window for its controls. egui gives one image. The reader cannot find photo 3, so it cannot rate it.</p>
        <figcaption>
          The window is the same for each reader. Only the agent with MCP
          gets the photos as text. The screen reader does not get this text
          yet, because egui does not give it to the operating system.
        </figcaption>
      </figure>

      <figure class="lp-figure">
        <svg viewBox="0 0 640 250" role="img" aria-label="Six inputs on the left: keyboard shortcuts, the menu bar, drive scripts, the control channel, lightphotos-mcp and WebMCP. Each has an arrow into one Command type with 30 ids, which runs the action in the app.">
          <text class="lp-fig-label" x="0" y="12">WHO ASKS</text>

          <rect class="lp-fig-panel" x="0" y="24" width="220" height="30" rx="6"></rect>
          <text class="lp-fig-s" x="14" y="44">Keyboard shortcuts</text>
          <rect class="lp-fig-panel" x="0" y="62" width="220" height="30" rx="6"></rect>
          <text class="lp-fig-s" x="14" y="82">Menu bar</text>
          <rect class="lp-fig-panel" x="0" y="100" width="220" height="30" rx="6"></rect>
          <text class="lp-fig-mono lp-fig-s" x="14" y="120">--drive scripts</text>
          <rect class="lp-fig-panel" x="0" y="138" width="220" height="30" rx="6"></rect>
          <text class="lp-fig-mono lp-fig-s" x="14" y="158">--control (TCP)</text>
          <rect class="lp-fig-panel" x="0" y="176" width="220" height="30" rx="6"></rect>
          <text class="lp-fig-mono lp-fig-s" x="14" y="196">lightphotos-mcp</text>
          <rect class="lp-fig-panel" x="0" y="214" width="220" height="30" rx="6"></rect>
          <text class="lp-fig-s" x="14" y="234">WebMCP in the browser</text>

          <path class="lp-fig-line" d="M220 39 H280 V135 H372"></path>
          <path class="lp-fig-line" d="M220 77 H280"></path>
          <path class="lp-fig-line" d="M220 115 H280"></path>
          <path class="lp-fig-line" d="M220 153 H280"></path>
          <path class="lp-fig-line" d="M220 191 H280"></path>
          <path class="lp-fig-line" d="M220 229 H280 V135"></path>
          <path class="lp-fig-arrow" d="M372 130 L372 140 L380 135 Z"></path>

          <text class="lp-fig-label" x="392" y="12">ONE LIST OF ACTIONS</text>
          <rect class="lp-fig-box-accent" x="392" y="62" width="248" height="146" rx="8"></rect>
          <text class="lp-fig-mono lp-fig-t" x="406" y="88">enum Command</text>
          <text class="lp-fig-s" x="406" y="110">30 ids, each with typed params</text>
          <text class="lp-fig-mono lp-fig-s" x="422" y="136">photo.rate</text>
          <text class="lp-fig-mono lp-fig-s" x="422" y="156">develop.set</text>
          <text class="lp-fig-mono lp-fig-s" x="422" y="176">mask.add</text>
          <text class="lp-fig-s" x="422" y="196">&hellip;</text>
        </svg>
        <figcaption>
          Every way to tell LightPhotos to do something ends at the same
          type. A new command is available to all six at once.
        </figcaption>
      </figure>

      <h2>What I gave up, and what I got back</h2>
      <p>
        In <a href="/blogs/why-rust.html">Why Rust</a>, I wrote that I
        accepted weaker accessibility. Browsers give screen reader support
        for free. The Rust UI libraries, egui among them, are far behind. In
        <a href="/blogs/my-plan.html">my plan</a>, I wrote that keyboard
        support is the part of that problem that I can fix myself. So every
        feature will work without the mouse.
      </p>
      <p>
        To make every feature work from the keyboard, I had to give every
        feature a name. That became <code>src/command.rs</code>: one Rust
        enum, <code>Command</code>, with a variant for each action. Each
        variant has a fixed id, such as <code>photo.rate</code>, and a params
        struct, such as <code>&#123;"stars": 4&#125;</code>. The keyboard and the menu
        bar do not call the editor directly. They make a
        <code>Command</code> and dispatch it.
      </p>
      <p>
        When I added the MCP server, most of the work was already done.
        <code>lightphotos-mcp</code> reads the same enum.
        <code>list_commands</code> prints each id with an example of its
        params. <code>run_command</code> parses the JSON into a
        <code>Command</code> and runs it. I did not write a second API for
        agents. The agent uses the list of actions that I wrote for the
        keyboard.
      </p>
      <p>
        The server runs in two modes. With <code>--folder</code>, it needs
        no app. It writes ratings, flags, labels and edits into the
        sidecars next to the photos, and <code>render</code> returns a photo
        with its edits as a JPEG, so the agent can look at its own work.
        With <code>--attach</code>, it drives a running app, and
        <code>screenshot</code> returns the window. In the browser, the web
        app registers the same tools with WebMCP, so an agent in the browser
        uses the open tab.
      </p>

      <h2>A feature that only the mouse can do</h2>
      <p>
        The rule I follow now is this: if a feature has no command, it does
        not exist for a keyboard user or for an agent. Brush masks showed
        me where I had broken the rule. A brush stroke was a drag with the
        mouse, and nothing else. A screen reader user could not paint one.
        An agent could not paint one either.
      </p>
      <p>
        To give brush masks to agents, I had to describe a stroke in words:
        <code>mask.add</code> now takes a list of points. That is also the
        description an assistive tool needs. When I fixed the feature for
        the power user, I fixed it for the user with a disability too. The
        reverse is also true. When you make a feature accessible, you have
        usually also made it available to agents.
      </p>
      <p>
        The same is true for errors. A sighted user sees a disabled button
        and understands. A screen reader user needs the reason in words. An
        agent needs it in words too, and it also needs the next step. When a
        LightPhotos tool fails, its reply says what to do next. An unknown
        id gets &ldquo;Call <code>list_commands</code> to see every
        id.&rdquo; A
        good error for an agent is a good error for a person.
      </p>

      <h2>Where the comparison breaks</h2>
      <p>
        The two are not equal. Accessibility is about whether a person can
        use the app at all. In many countries it is the law. MCP is about
        speed for people who can already use the app. I am not saying that
        an MCP server is a substitute for screen reader support. It is not.
        A blind user of LightPhotos today still gets a window of egui
        pixels, and MCP does not change that.
      </p>
      <p>
        An agent can also do damage at a scale a person cannot. One wrong
        instruction can change 1,200 sidecars. So the agent path has guards
        that a screen reader does not need. In headless mode, the server
        checks every photo in a batch before it writes any of them. It
        refuses a symlink that leads out of the folder. In attached mode,
        the app requires a token, and the server reads the token only from
        the environment, so <code>ps</code> does not show it to other users.
      </p>

      <h2>What this changes</h2>
      <p>
        A feature in LightPhotos is now finished when it has three things:
        a control on the screen, a <code>Command</code> with a name and
        params, and state that <code>get_state</code> or
        <code>list_photos</code> can report. The second and third are what
        the keyboard, the menu bar and the agent use. They are also the
        text a screen reader would need. When egui can expose more than
        pixels, the names and the state will already exist.
      </p>
      <p>
        I used to think of accessibility as work for a small group of
        users. Now I think of it as the work that makes the app readable by
        anything other than a pair of eyes. A person with a disability was
        the first user who needed that. An agent is the second. The README
        has the steps to
        <a href="https://github.com/andrewyao/lightphotos#agent-control-mcp">connect
        an agent</a>. If a feature has no command yet,
        <a href="https://github.com/andrewyao/lightphotos/issues">open an
        issue</a>.
      </p>

      <nav class="lp-article-nav" aria-label="More posts">
        <a class="lp-article-nav-prev" href="/blogs/lightphotos-and-rapidraw-on-the-mac.html">
          <span class="lp-article-nav-dir">Back</span>
          <span class="lp-article-nav-title">LightPhotos and RapidRAW on the Mac</span>
        </a>
        <a class="lp-article-nav-next" href="/blogs/three-ways-to-cull-a-shoot-with-mcp.html">
          <span class="lp-article-nav-dir">Next</span>
          <span class="lp-article-nav-title">Three ways to let AI cull a shoot</span>
        </a>
      </nav>
    </article>
  </main>
  <script>
    const fig = document.getElementById("reader-demo");
    if (fig) {
      const buttons = fig.querySelectorAll("[data-reader]");
      const views = fig.querySelectorAll("[data-view]");
      const readout = fig.querySelector(".lp-try-readout");
      const MESSAGES = {
        sr: "The screen reader asks the window for its controls. egui gives one image. The reader cannot find photo 3, so it cannot rate it.",
        shot: "The agent gets a PNG. It guesses the stars from the pixels, then it clicks at a position. If the layout moves, the click goes to the wrong photo.",
        mcp: "The agent reads each photo and its rating as text. It sends photo.rate with 3 stars. The reply tells the agent that the command worked.",
      };

      const show = (reader) => {
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.reader === reader)));
        views.forEach((v) => {
          if (v.getAttribute("data-view") === reader) v.removeAttribute("display");
          else v.setAttribute("display", "none");
        });
        readout.textContent = MESSAGES[reader];
      };

      buttons.forEach((btn) => btn.addEventListener("click", () => show(btn.dataset.reader)));
    }
  </script>
</Base>
