---
// /docs.html is the entry point every nav link, landing card and breadcrumb
// points at, so it forwards straight to the first topic rather than sitting
// as an index nobody asked for — the sidebar on each topic is the index.
// Production never serves this page: public/_redirects sends /docs and
// /docs.html (in every language) to the first topic server-side. It remains for
// `astro dev`, which ignores _redirects, as a meta refresh with a real link
// underneath.
import { docHref } from "../../docs";
import { localeInfo } from "../../i18n/locales";
import { languagePaths, type LanguageProps } from "../../i18n/routes";
import { ui } from "../../i18n/ui";

export const getStaticPaths = languagePaths;
const { lang } = Astro.props as LanguageProps;
const t = ui(lang).docs;
const target = docHref(lang, "open-the-app");
---
<!doctype html>
<html lang={localeInfo[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('lp-theme');
          if (t === 'light' || t === 'neutral' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{t.redirectTitle}</title>
    <link rel="stylesheet" href="/lp.css" />
    <style>
      html { color-scheme: dark light; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-content: center;
        gap: 0.75rem;
        padding: 2rem;
        text-align: center;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: var(--lp-bg, #14110c);
        color: var(--lp-fg, #f3eee3);
      }
      a { color: #4f8cff; }
    </style>
  </head>
  <body>
    <p>{t.redirecting}</p>
    <p><a href={target}>{t.redirectLink}</a></p>
  </body>
</html>
